@model List<ValousWorld.Web.Models.Entities.Product>
@{
    ViewData["Title"] = "New Arrivals";
    ViewData["Breadcrumb"] = Html.Raw("<a href='/'>Home</a> / <a href='/'>Shop</a> / <span>New Arrivals</span>");
}

<section class="hero-banner">
    <div class="hero-overlay">
        <h1>NEW ARRIVALS</h1>
        <div class="hero-tags">
            <div class="hero-tag">
                <div class="tag-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                </div>
                <span>All-Day Comfort Fit</span>
            </div>
            <div class="hero-tag">
                <div class="tag-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20.38 3.46L16 2a4 4 0 0 1-8 0L3.62 3.46a2 2 0 0 0-1.34 2.23l.58 3.47a1 1 0 0 0 .99.84H6v10a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1V10h2.15a1 1 0 0 0 .99-.84l.58-3.47a2 2 0 0 0-1.34-2.23z"/></svg>
                </div>
                <span>Effortless Fresh Look</span>
            </div>
            <div class="hero-tag">
                <div class="tag-icon">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><line x1="20" y1="4" x2="8.12" y2="15.88"/><line x1="14.47" y1="14.48" x2="20" y2="20"/><line x1="8.12" y1="8.12" x2="12" y2="12"/></svg>
                </div>
                <span>Easy To Style Silhouettes</span>
            </div>
        </div>
    </div>
</section>

<div class="filter-bar">
    <div class="container filter-inner">
        <a href="/shop" class="filter-products-btn">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <polygon points="22 3 2 3 10 12.46 10 19 14 21 14 12.46 22 3"/>
            </svg>
            FILTER PRODUCTS
        </a>
        <span class="product-count">@ViewBag.TotalProducts PRODUCTS</span>
    </div>
</div>

<section class="products-section">
    <div class="container">
        @if (!Model.Any())
        {
            <p style="text-align:center; padding:60px 0; color:#888;">
                No products yet. <a href="/Admin/Products/Create" style="text-decoration:underline;">Add one in admin.</a>
            </p>
        }
        else
        {
            <div class="products-grid">
                @foreach (var p in Model)
                {
                    <a href="/product/@p.ProductId" class="product-card">
                        <div class="product-image">
                          @if (p.SavePercent > 0 && p.SalePrice.HasValue && p.SalePrice.Value > 0)
                            {
                                <span class="save-badge">SAVE @p.SavePercent%</span>
                            }
                            <img src="@p.PrimaryImageUrl" alt="@p.Name" loading="lazy" />
                            <button class="quick-add" onclick="event.preventDefault();">ADD TO CART</button>
                        </div>
                        <div class="product-info">
                            <h3>@p.Name</h3>
                           <div class="price-row">
                                @if (p.SavePercent > 0 && p.SalePrice.HasValue && p.SalePrice.Value > 0)
                                {
                                    <span class="mrp">Rs.@p.MRP.ToString("0")</span>
                                    <span class="sale">Rs.@p.SalePrice.Value.ToString("0.00")</span>
                                }
                                else
                                {
                                    <span class="price-normal">Rs.@p.MRP.ToString("0")</span>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>
        }
    </div>
</section>
<style>
    .price-normal {
    font-weight: 700;
    color: var(--black);
    font-size: 13px;
}
</style>
<script>
    (function () {
        const sel = document.getElementById('homeSort');
        const form = document.getElementById('homeSortForm');
        if (!sel || !form) return;
        sel.addEventListener('change', () => form.submit());
    })();

    (function () {
    const filterBar = document.querySelector('.filter-bar');
    const header = document.querySelector('.site-header');
    if (!filterBar) return;

    let headerHeight = 0;

    function updateOffsets() {
        headerHeight = header ? header.getBoundingClientRect().height : 0;
        document.documentElement.style.setProperty('--header-h', headerHeight + 'px');
        checkStuck();
    }

    function checkStuck() {
        const rect = filterBar.getBoundingClientRect();
        filterBar.classList.toggle('is-stuck', rect.top <= headerHeight + 1);
    }

    window.addEventListener('scroll', checkStuck, { passive: true });
    window.addEventListener('resize', updateOffsets);
    window.addEventListener('load', updateOffsets);   // logo/fonts can change header height
    updateOffsets();
})();  
</script>