@* @{
    ViewData["Title"] = "Admin Dashboard";
    ViewData["Breadcrumb"] = Html.Raw("<span>Admin / Dashboard</span>");
} *@

<div class="container admin-page">

    <!-- ============ TOP HEADER WITH BACK BUTTON ============ -->
    <div class="admin-dashboard-header">
        <h1>ADMIN DASHBOARD</h1>
        <a href="/" class="btn-back-website">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="19" y1="12" x2="5" y2="12"/>
                <polyline points="12 19 5 12 12 5"/>
            </svg>
            BACK TO Store
        </a>
    </div>

    <!-- ============ EXISTING GRID ============ -->
    <div class="dashboard-grid">
        <div class="dash-card">
            <h3>Products</h3>
            <p class="dash-stat">@ViewBag.ProductCount</p>
            <a href="/Admin/Products" class="btn-outline">Manage →</a>
        </div>
        <div class="dash-card">
            <h3>Categories</h3>
            <p class="dash-stat">@ViewBag.CategoryCount</p>
            <a href="/Admin/Categories" class="btn-outline">Manage →</a>
        </div>
        <div class="dash-card">
            <h3>Announcements</h3>
            <p class="dash-stat">@ViewBag.AnnouncementCount</p>
            <a href="/Admin/Announcements" class="btn-outline">Manage →</a>
        </div>
        <div class="dash-card">
            <h3>Users</h3>
            <p class="dash-stat">@ViewBag.UserCount</p>
        </div>
        <div class="dash-card">
            <h3>New Arrivals</h3>
            <p class="dash-stat">@ViewBag.NewArrivals</p>
        </div>
    </div>
</div>

<style>
    .admin-page {
        padding: 20px;
    }

    /* ---------- Admin Dashboard Header ---------- */
    .admin-dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid var(--black);
    }

    .admin-dashboard-header h1 {
        font-size: 22px;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0;
    }

    /* ---------- Back Button ---------- */
    .btn-back-website {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: var(--black);
        color: var(--white);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        text-decoration: none;
        border: 1.5px solid var(--black);
        border-radius: 2px;
        transition: all 0.2s;
        line-height: 1;
    }

    .btn-back-website:hover {
        background: transparent;
        color: var(--black);
    }

    .btn-back-website svg {
        flex-shrink: 0;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 500px) {
        .admin-dashboard-header {
            flex-direction: column;
            align-items: stretch;
        }

        .admin-dashboard-header h1 {
            font-size: 18px;
        }

        .btn-back-website {
            width: 100%;
            justify-content: center;
        }
    }
</style>