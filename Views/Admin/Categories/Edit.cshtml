@model ValousWorld.Web.Models.Entities.Category
@{ ViewData["Title"] = "Edit Category"; }

<div class="container admin-page">
    <div class="admin-header">
        <h1>EDIT CATEGORY</h1>
        <div class="admin-header-actions">
            <a href="http://localhost:5132/Admin/Dashboard" class="btn-outline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
                </svg>
                BACK TO DASHBOARD
            </a>
            <a href="/Admin/Categories" class="btn-outline">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
                </svg>
                BACK TO LIST
            </a>
        </div>
    </div>

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" action="/Admin/Categories/Edit/@Model.CategoryId"
          enctype="multipart/form-data" class="admin-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="CategoryId" />

        <!-- LEFT -->
        <div class="form-main">
            <div class="form-card">
                <h3>DETAILS</h3>

                <label>Category Name *</label>
                <input asp-for="Name" required />

                <label>Slug</label>
                <input asp-for="Slug" />

                <label>Display Order</label>
                <input asp-for="DisplayOrder" type="number" min="0" />
            </div>
        </div>

        <!-- RIGHT -->
        <div class="form-side">
            <div class="form-card">
                <h3>IMAGE</h3>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <label>Current Image</label>
                    <div class="current-image">
                        <img src="@Model.ImageUrl" alt="current" />
                    </div>
                }

                <label style="margin-top:12px;">Replace Image</label>
                <div class="upload-block">
                    <input type="file" name="imageFile" accept="image/*" id="imgInput" />
                    <div class="upload-hint">JPG, PNG, WEBP, GIF — Max 5 MB</div>
                    <img id="imgPreview" class="upload-preview" style="display:none;" alt="preview" />
                </div>

                <label style="margin-top:12px;">Or edit Image URL</label>
                <input asp-for="ImageUrl" />
            </div>

            <div class="form-card">
                <h3>STATUS</h3>
                <div class="check-row">
                    <label><input asp-for="IsActive" type="checkbox" /> Active</label>
                </div>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn-primary btn-block">UPDATE CATEGORY</button>
                <a href="/Admin/Categories" class="btn-outline btn-block">CANCEL</a>
            </div>
        </div>
    </form>
</div>

<style>
    .admin-page { padding: 28px 20px 60px; max-width: 1080px; margin: 0 auto; }

    .admin-header {
        display: flex; align-items: center; justify-content: space-between;
        gap: 12px; flex-wrap: wrap; margin-bottom: 24px;
    }
    .admin-header h1 { font-size: 20px; font-weight: 800; letter-spacing: 1px; margin: 0; color: var(--black); }
    .admin-header-actions { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }

    .btn-primary, .btn-outline {
        display: inline-flex; align-items: center; justify-content: center; gap: 6px;
        padding: 10px 16px; font-size: 12px; font-weight: 700; letter-spacing: 0.5px;
        text-transform: uppercase; border-radius: 4px; text-decoration: none;
        cursor: pointer; transition: all 0.15s; white-space: nowrap; border: 1.5px solid;
    }
    .btn-primary { background: var(--black); border-color: var(--black); color: var(--white); }
    .btn-primary:hover { opacity: 0.85; }
    .btn-outline { background: var(--white); border-color: var(--gray-200); color: var(--gray-800); }
    .btn-outline:hover { border-color: var(--black); background: var(--gray-100); }
    .btn-outline svg { transform: scaleX(-1); }
    .btn-block { width: 100%; }

    .text-danger { color: #b71c1c; font-size: 12.5px; margin-bottom: 12px; }
    .text-danger:empty { display: none; }

    /* ---------- Form layout ---------- */
    .admin-form {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        gap: 20px;
        align-items: start;
    }
    .form-main, .form-side { display: flex; flex-direction: column; gap: 16px; }

    .form-card {
        background: var(--white);
        border: 1px solid var(--gray-200);
        border-radius: 8px;
        padding: 20px;
    }
    .form-card h3 {
        margin: 0 0 14px;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: var(--gray-600);
        padding-bottom: 10px;
        border-bottom: 1px solid var(--gray-200);
    }

    .form-card label {
        display: block;
        font-size: 11.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--gray-700, var(--gray-600));
        margin: 14px 0 6px;
    }
    .form-card label:first-of-type { margin-top: 0; }

    .form-card input[type="text"],
    .form-card input[type="number"],
    .form-card input:not([type="checkbox"]):not([type="file"]) {
        width: 100%;
        padding: 10px 12px;
        font-size: 13px;
        border: 1.5px solid var(--gray-200);
        border-radius: 5px;
        background: var(--white);
        color: var(--black);
        transition: border-color 0.15s;
        box-sizing: border-box;
    }
    .form-card input:focus {
        outline: none;
        border-color: var(--black);
    }

    /* ---------- Upload block ---------- */
    .upload-block {
        border: 1.5px dashed var(--gray-200);
        border-radius: 6px;
        padding: 16px;
        text-align: center;
        background: var(--gray-100);
    }
    .upload-block input[type="file"] {
        width: 100%;
        font-size: 12px;
        color: var(--gray-700, var(--gray-600));
    }
    .upload-hint {
        font-size: 10.5px;
        color: var(--gray-500, var(--gray-600));
        margin-top: 8px;
        letter-spacing: 0.3px;
    }
    .upload-preview {
        margin-top: 12px;
        max-width: 100%;
        max-height: 160px;
        border-radius: 4px;
        border: 1px solid var(--gray-200);
        object-fit: cover;
    }
    .current-image img {
        width: 100%;
        max-height: 160px;
        object-fit: cover;
        border-radius: 4px;
        border: 1px solid var(--gray-200);
        display: block;
    }

    /* ---------- Checkbox row ---------- */
    .check-row label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
        font-weight: 600;
        text-transform: none;
        letter-spacing: 0;
        color: var(--black);
        cursor: pointer;
    }
    .check-row input[type="checkbox"] {
        width: 16px;
        height: 16px;
        accent-color: var(--black);
        cursor: pointer;
    }

    /* ---------- Actions ---------- */
    .form-actions {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    /* ============================================================
       RESPONSIVE
       ============================================================ */
    @@media (max-width: 900px) {
        .admin-form { grid-template-columns: 1fr; }
    }
    @@media (max-width: 480px) {
        .admin-header-actions { width: 100%; }
        .admin-header-actions a { flex: 1; }
        .form-card { padding: 16px; }
    }
</style>

<script>
    (function () {
        const input = document.getElementById('imgInput');
        const preview = document.getElementById('imgPreview');
        input.addEventListener('change', () => {
            const file = input.files[0];
            if (!file) { preview.style.display = 'none'; return; }
            preview.src = URL.createObjectURL(file);
            preview.style.display = 'block';
        });
    })();
</script>
