@model ValousWorld.Web.ViewModels.Admin.AdminOrderDetailVm
@{
    ViewData["Title"] = "Admin · Order " + Model.Order.OrderNumber;
    var o = Model.Order;
    string StatusClass(string s) => "order-status-" + (s ?? "").ToLower();

    var displayName = string.IsNullOrWhiteSpace(Model.DisplayUserName) ? o.ShippingFullName : Model.DisplayUserName;
    var initial = string.IsNullOrWhiteSpace(displayName) ? "?" : displayName.Trim().Substring(0, 1).ToUpper();
}

<div class="container admin-page">

    @if (TempData["Success"] != null) { <div class="alert-success">@TempData["Success"]</div> }
    @if (TempData["Error"] != null)   { <div class="alert-error">@TempData["Error"]</div> }

    <!-- ============ HEADER ============ -->
    <div class="admin-header">
        <div>
            <div class="adm-title-row">
                <h1>ORDER @o.OrderNumber</h1>
                <span class="order-status @StatusClass(o.Status)">@o.Status</span>
            </div>
            <p class="adm-sub">Placed @o.PlacedAt.ToString("dd MMM yyyy, HH:mm") UTC</p>
        </div>
        <div class="admin-header-actions">
            <a href="/Admin/Orders/@o.OrderId/invoice" class="btn-secondary" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14 2 14 8 20 8"/>
                    <line x1="9" y1="13" x2="15" y2="13"/><line x1="9" y1="17" x2="15" y2="17"/>
                </svg>
                INVOICE
            </a>
            <a href="/Admin/Orders" class="btn-secondary">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
                </svg>
                BACK TO ORDERS
            </a>
        </div>
    </div>

    <div class="adm-grid">

        <!-- ============ LEFT COLUMN ============ -->
        <div class="adm-col">

            <!-- CUSTOMER -->
            <div class="adm-card">
                <h3>Customer</h3>
                <div class="adm-person">
                    <span class="adm-avatar" aria-hidden="true">@initial</span>
                    <div class="adm-person-info">
                        <span class="adm-person-name">@Model.DisplayUserName</span>
                        <span class="adm-person-mail">@Model.DisplayEmail</span>
                    </div>
                </div>
                <div class="adm-kv-grid">
                    <div class="adm-kv">
                        <span class="adm-k">User ID</span>
                        <span class="adm-v">#@o.UserId</span>
                    </div>
                    <div class="adm-kv">
                        <span class="adm-k">Phone (shipping)</span>
                        <span class="adm-v">@o.ShippingPhone</span>
                    </div>
                </div>
            </div>

            <!-- SHIPPING -->
            <div class="adm-card">
                <h3>Shipping address</h3>
                <div class="adm-address">
                    <p class="adm-address-name">@o.ShippingFullName</p>
                    <p class="adm-address-phone">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/>
                        </svg>
                        @o.ShippingPhone
                    </p>
                    <p>@o.ShippingLine1</p>
                    @if (!string.IsNullOrWhiteSpace(o.ShippingLine2)) { <p>@o.ShippingLine2</p> }
                    <p>@o.ShippingCity, @o.ShippingState — @o.ShippingPincode</p>
                    <p>@o.ShippingCountry</p>
                </div>
                @if (!string.IsNullOrWhiteSpace(o.TrackingNumber))
                {
                    <p class="adm-tracking">
                        <strong>Tracking</strong>
                        <a href="https://www.delhivery.com/track/package/@o.TrackingNumber" target="_blank" rel="noopener">
                            @o.CourierName — @o.TrackingNumber
                        </a>
                        @* @if (!string.IsNullOrWhiteSpace(o.DelhiveryStatus))
                        {
                            <span class="adm-substatus">(@o.DelhiveryStatus)</span>
                        } *@
                    </p>
                }
            </div>

            <!-- ITEMS -->
            <div class="adm-card">
                <h3>Items <span class="adm-count">@o.Items.Count</span></h3>
                @foreach (var i in o.Items)
                {
                    <div class="adm-item">
                        @if (!string.IsNullOrWhiteSpace(i.ProductImage))
                        {
                            <img src="@i.ProductImage" alt="@i.ProductName" loading="lazy" />
                        }
                        else
                        {
                            <div class="adm-noimg"></div>
                        }
                        <div class="adm-item-info">
                            <p class="adm-item-name">@i.ProductName</p>
                            <p class="adm-item-meta">
                                @if (!string.IsNullOrWhiteSpace(i.Size)) { <span class="adm-chip">Size @i.Size</span> }
                                @if (!string.IsNullOrWhiteSpace(i.Color)) { <span class="adm-chip">@i.Color</span> }
                                <span class="adm-chip">Qty @i.Quantity</span>
                                <span class="adm-unit">₹@i.UnitPrice.ToString("0.00") each</span>
                            </p>
                        </div>
                        <div class="adm-item-price">₹@i.LineTotal.ToString("0.00")</div>
                    </div>
                }
            </div>

            <!-- PAYMENT ATTEMPTS -->
            @if (o.PaymentAttemptLog != null && o.PaymentAttemptLog.Any())
            {
                <div class="adm-card">
                    <h3>Payment attempts <span class="adm-count">@o.PaymentAttemptLog.Count</span></h3>
                    <div class="adm-table-wrap">
                        <table class="adm-table">
                            <thead>
                                <tr>
                                    <th>When</th>
                                    <th>Status</th>
                                    <th>Amount</th>
                                    <th>Code / Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in o.PaymentAttemptLog.OrderByDescending(x => x.AttemptedAt))
                                {
                                    <tr>
                                        <td>@a.AttemptedAt.ToString("dd MMM HH:mm:ss")</td>
                                        <td><span class="order-status @StatusClass(a.Status)">@a.Status</span></td>
                                        <td>₹@a.Amount.ToString("0.00")</td>
                                        <td>@(string.IsNullOrWhiteSpace(a.ErrorCode) ? "—" : a.ErrorCode) @a.ErrorDescription</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

        </div>

        <!-- ============ RIGHT COLUMN ============ -->
        <div class="adm-col">

            <!-- STATUS + TIMELINE -->
            <div class="adm-card">
                <h3>Status</h3>
                <div class="adm-status-row">
                    <span class="order-status @StatusClass(o.Status)">@o.Status</span>
                    <span class="order-status @StatusClass(o.PaymentStatus)">@o.PaymentStatus</span>
                </div>

                <div class="adm-timeline">
                    <div class="adm-tl-row"><span>Placed</span><span>@o.PlacedAt.ToString("dd MMM yyyy HH:mm")</span></div>
                    @if (o.PaidAt.HasValue)        { <div class="adm-tl-row"><span>Paid</span><span>@o.PaidAt.Value.ToString("dd MMM yyyy HH:mm")</span></div> }
                    @if (o.ShippedAt.HasValue)     { <div class="adm-tl-row"><span>Shipped</span><span>@o.ShippedAt.Value.ToString("dd MMM yyyy HH:mm")</span></div> }
                    @if (o.DeliveredAt.HasValue)   { <div class="adm-tl-row tl-good"><span>Delivered</span><span>@o.DeliveredAt.Value.ToString("dd MMM yyyy HH:mm")</span></div> }
                    @if (o.CodCollectedAt.HasValue){ <div class="adm-tl-row tl-good"><span>COD collected</span><span>@o.CodCollectedAt.Value.ToString("dd MMM yyyy HH:mm")</span></div> }
                    @if (o.CancelledAt.HasValue)   { <div class="adm-tl-row tl-bad"><span>Cancelled</span><span>@o.CancelledAt.Value.ToString("dd MMM yyyy HH:mm") · @o.CancelledBy</span></div> }
                    @if (o.RefundedAt.HasValue)    { <div class="adm-tl-row tl-good"><span>Refunded</span><span>@o.RefundedAt.Value.ToString("dd MMM yyyy HH:mm")</span></div> }
                </div>
            </div>

            <!-- PAYMENT SUMMARY -->
            <div class="adm-card">
                <h3>Payment</h3>
                <div class="os-row"><span>Subtotal</span><span>₹@o.Subtotal.ToString("0.00")</span></div>
                @if (o.Discount > 0)
                {
                    <div class="os-row os-save"><span>Discount</span><span>−₹@o.Discount.ToString("0.00")</span></div>
                }
                <div class="os-row"><span>Shipping</span><span>₹@o.Shipping.ToString("0.00")</span></div>
                @if (o.CodFee > 0)
                {
                    <div class="os-row"><span>COD handling</span><span>₹@o.CodFee.ToString("0.00")</span></div>
                }
                <div class="os-row os-total"><span>Total</span><span>₹@o.Total.ToString("0.00")</span></div>

                <div class="os-divider"></div>
                <div class="os-row os-meta"><span>Method</span><span>@(o.PaymentMethod == "COD" ? "Cash on Delivery" : o.PaymentMethod)</span></div>
                <div class="os-row os-meta"><span>Status</span><span>@o.PaymentStatus</span></div>
                @if (!string.IsNullOrWhiteSpace(o.RazorpayPaymentId))
                {
                    <div class="os-row os-meta"><span>Txn ID</span><span>@o.RazorpayPaymentId</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(o.RefundId))
                {
                    <div class="os-row os-meta os-refund"><span>Refund</span><span>₹@o.RefundedAmount?.ToString("0.00") — @o.RefundStatus</span></div>
                }
                @if (!string.IsNullOrWhiteSpace(o.CancellationReason))
                {
                    <div class="os-row os-meta"><span>Cancel reason</span><span>@o.CancellationReason</span></div>
                }
            </div>

            <!-- ADMIN ACTIONS -->
            <div class="adm-card adm-actions-card">
                <h3>Admin actions</h3>

                @if (Model.CanMarkDelivered)
                {
                    <form method="post" action="/Admin/Orders/@o.OrderId/mark-delivered"
                          class="adm-action-form" onsubmit="return confirm('Mark this order as delivered and record COD cash collected?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="adm-action-btn adm-action-primary">
                            MARK COD AS DELIVERED
                        </button>
                    </form>
                }

                @if (Model.CanRefund)
                {
                    <button type="button" class="adm-action-btn" id="openRefundBtn">
                        REFUND MANUALLY
                    </button>
                }

                @if (Model.CanResync)
                {
                    <form method="post" action="/Admin/Orders/@o.OrderId/resync"
                          class="adm-action-form" onsubmit="return confirm('Fetch latest status from Delhivery?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="adm-action-btn">RESYNC TRACKING</button>
                    </form>
                }

                @if (Model.CanCancel)
                {
                    <button type="button" class="adm-action-btn adm-action-danger" id="openCancelBtn">
                        CANCEL ORDER
                    </button>
                }

                @if (!Model.CanMarkDelivered && !Model.CanRefund && !Model.CanResync && !Model.CanCancel)
                {
                    <p class="adm-noactions">No actions available for this order.</p>
                }
            </div>
        </div>
    </div>
</div>

<!-- ============ CANCEL MODAL ============ -->
<div class="confirm-overlay" id="cancelModal" hidden>
    <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="cancelTitle">
        <h4 id="cancelTitle">Cancel order @o.OrderNumber?</h4>
        <form method="post" action="/Admin/Orders/@o.OrderId/cancel">
            @Html.AntiForgeryToken()
            <p>This action cannot be undone. If the order is paid, a refund will be initiated automatically.</p>
            <select name="reason" required class="adm-reason">
                <option value="">Select a reason…</option>
                <option>Customer request</option>
                <option>Out of stock</option>
                <option>Payment verification failed</option>
                <option>Address unserviceable</option>
                <option>Duplicate order</option>
                <option>Other</option>
            </select>
            <div class="confirm-actions">
                <button type="button" class="confirm-btn confirm-btn-ghost" data-close="cancelModal">KEEP ORDER</button>
                <button type="submit" class="confirm-btn confirm-btn-danger">YES, CANCEL</button>
            </div>
        </form>
    </div>
</div>

<!-- ============ REFUND MODAL ============ -->
<div class="confirm-overlay" id="refundModal" hidden>
    <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="refundTitle">
        <h4 id="refundTitle">Refund ₹@o.Total.ToString("0.00")?</h4>
        <form method="post" action="/Admin/Orders/@o.OrderId/refund">
            @Html.AntiForgeryToken()
            <p>Full refund will be issued to the customer's original payment method via Razorpay.</p>
            <input type="text" name="reason" required placeholder="Reason for refund" class="adm-reason" />
            <div class="confirm-actions">
                <button type="button" class="confirm-btn confirm-btn-ghost" data-close="refundModal">CLOSE</button>
                <button type="submit" class="confirm-btn confirm-btn-danger">REFUND NOW</button>
            </div>
        </form>
    </div>
</div>

<style>
    /* ============ Tokens (scoped to this page) ============ */
    .admin-page {
        --a-ink: var(--black, #0e0e10);
        --a-ink-2: #34343a;
        --a-muted: #74747c;
        --a-line: #e7e7eb;
        --a-line-soft: #f0f0f3;
        --a-wash: #f7f7f9;
        --a-surface: var(--white, #fff);
        --a-gold: #b8860b;
        font-variant-numeric: tabular-nums;
        padding-bottom: 40px;
    }

    /* ============ Header ============ */
    .admin-header {
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 16px; flex-wrap: wrap;
        margin-bottom: 24px;
    }
    .adm-title-row { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .admin-header h1 {
        font-size: 26px; font-weight: 900;
        letter-spacing: 2.5px; text-transform: uppercase;
        margin: 0; line-height: 1.15; color: var(--a-ink);
        overflow-wrap: anywhere;
    }
    .adm-sub { font-size: 13px; color: var(--a-muted); margin: 6px 0 0; }
    .admin-header-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    .btn-secondary {
        display: inline-flex; align-items: center; justify-content: center; gap: 8px;
        height: 42px; padding: 0 18px;
        font-family: inherit; font-size: 11.5px; font-weight: 700;
        letter-spacing: 1px; text-transform: uppercase;
        border: 1px solid var(--a-line);
        background: var(--a-surface); color: var(--a-ink-2);
        border-radius: 10px; text-decoration: none; cursor: pointer;
        transition: background .18s, color .18s, border-color .18s;
    }
    .btn-secondary:hover { border-color: var(--a-ink); background: var(--a-ink); color: #fff; }
    .btn-secondary:focus-visible, .adm-action-btn:focus-visible, .confirm-btn:focus-visible {
        outline: 2px solid var(--a-gold); outline-offset: 2px;
    }

    .alert-success, .alert-error {
        border-radius: 12px; padding: 13px 16px 13px 18px;
        font-size: 13px; font-weight: 500; margin-bottom: 16px;
        border: 1px solid; border-left-width: 4px;
    }
    .alert-success { background:#f1faf3; color:#1e6b32; border-color:#cfe9d5; border-left-color:#2e9e4f; }
    .alert-error   { background:#fdf3f2; color:#a3201a; border-color:#f3d0cd; border-left-color:#d6403a; }

    /* ============ Layout ============ */
    .adm-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 390px;
        gap: 20px;
        align-items: start;
    }
    .adm-col { display: flex; flex-direction: column; gap: 16px; min-width: 0; }

    .adm-card {
        border: 1px solid var(--a-line);
        border-radius: 14px;
        padding: 20px 22px;
        background: var(--a-surface);
        box-shadow: 0 1px 2px rgba(16,16,24,.04), 0 12px 28px -20px rgba(16,16,24,.14);
    }
    .adm-card h3 {
        display: flex; align-items: center; gap: 8px;
        font-size: 14px; font-weight: 800; letter-spacing: .2px;
        color: var(--a-ink);
        margin: 0 0 14px; padding-bottom: 14px;
        border-bottom: 1px solid var(--a-line-soft);
    }
    .adm-count {
        display: inline-flex; align-items: center; justify-content: center;
        min-width: 22px; height: 22px; padding: 0 7px;
        font-size: 11.5px; font-weight: 700;
        background: var(--a-ink); color: #fff; border-radius: 20px;
    }
    .adm-card p {
        font-size: 13.5px; line-height: 1.6;
        margin: 2px 0; color: var(--a-ink-2);
        overflow-wrap: anywhere;
    }

    /* ---- Customer ---- */
    .adm-person { display: flex; align-items: center; gap: 14px; margin-bottom: 16px; }
    .adm-avatar {
        width: 46px; height: 46px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        border-radius: 50%; background: var(--a-ink); color: #fff;
        font-size: 18px; font-weight: 800;
    }
    .adm-person-info { display: flex; flex-direction: column; min-width: 0; }
    .adm-person-name { font-size: 15px; font-weight: 700; color: var(--a-ink); overflow-wrap: anywhere; }
    .adm-person-mail { font-size: 13px; color: var(--a-muted); overflow-wrap: anywhere; }

    .adm-kv-grid {
        display: grid; grid-template-columns: 1fr 1fr; gap: 10px 16px;
        padding: 14px 16px; background: var(--a-wash); border-radius: 10px;
    }
    .adm-kv { min-width: 0; }
    .adm-k { display: block; font-size: 11.5px; font-weight: 600; color: var(--a-muted); margin-bottom: 2px; }
    .adm-v { font-size: 13.5px; font-weight: 700; color: var(--a-ink); overflow-wrap: anywhere; }

    /* ---- Shipping ---- */
    .adm-address-name { font-size: 14.5px !important; font-weight: 700; color: var(--a-ink) !important; margin-bottom: 4px !important; }
    .adm-address-phone { display: flex; align-items: center; gap: 7px; color: var(--a-muted) !important; margin-bottom: 8px !important; }
    .adm-tracking {
        margin-top: 14px !important; padding: 11px 14px;
        background: var(--a-wash); border-radius: 10px;
        font-size: 13px !important; display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: center;
    }
    .adm-tracking strong { color: var(--a-muted); font-size: 12px; font-weight: 600; }
    .adm-tracking a { color: var(--a-ink); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; text-decoration-color: #c9c9d0; }
    .adm-tracking a:hover { text-decoration-color: var(--a-ink); }
    .adm-substatus { color: var(--a-muted); font-size: 11px; margin-left: 4px; }

    /* ---- Items ---- */
    .adm-item {
        display: grid; grid-template-columns: 60px minmax(0, 1fr) auto;
        gap: 16px; align-items: center;
        padding: 14px 0;
        border-bottom: 1px solid var(--a-line-soft);
    }
    .adm-item:last-child { border-bottom: none; padding-bottom: 0; }
    .adm-item:first-of-type { padding-top: 0; }
    .adm-item img, .adm-noimg {
        width: 60px; height: 76px; object-fit: cover;
        border-radius: 10px; background: var(--a-wash);
        border: 1px solid var(--a-line-soft);
    }
    .adm-item-name { font-size: 13.5px !important; font-weight: 700; color: var(--a-ink) !important; margin: 0 0 6px !important; line-height: 1.35 !important; }
    .adm-item-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 6px; margin: 0 !important; }
    .adm-chip {
        font-size: 11.5px; font-weight: 600; color: var(--a-ink-2);
        background: var(--a-wash); border: 1px solid var(--a-line);
        padding: 2px 9px; border-radius: 20px;
    }
    .adm-unit { font-size: 12px; color: var(--a-muted); margin-left: 2px; }
    .adm-item-price { font-size: 14px; font-weight: 800; color: var(--a-ink); white-space: nowrap; }

    /* ---- Status badges ---- */
    .adm-status-row { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 18px; }
    .order-status {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 10.5px; font-weight: 700; letter-spacing: .5px; text-transform: uppercase;
        padding: 5px 11px; border-radius: 20px; white-space: nowrap;
    }
    .order-status::before { content: ""; width: 6px; height: 6px; border-radius: 50%; background: currentColor; opacity: .85; }
    .order-status-created        { background:#f2f2f4; color:#4a4a52; }
    .order-status-paymentpending { background:#fff6dc; color:#7c5700; }
    .order-status-confirmed      { background:#e8f0fd; color:#1a4fa6; }
    .order-status-shipped        { background:#f4eafa; color:#7a2fa3; }
    .order-status-delivered      { background:#e8f6ec; color:#1e6b32; }
    .order-status-cancelled      { background:#fdeceb; color:#a3201a; }
    .order-status-failed         { background:#fdeceb; color:#a3201a; }
    .order-status-expired        { background:#eceff1; color:#455a64; }
    .order-status-refunded       { background:#e2f4f1; color:#00695c; }
    .order-status-returned       { background:#fff0e0; color:#c24e00; }
    .order-status-codpending     { background:#fff6dc; color:#7c5700; }
    .order-status-paid           { background:#e8f6ec; color:#1e6b32; }
    .order-status-pending        { background:#fff6dc; color:#7c5700; }
    .order-status-success        { background:#e8f6ec; color:#1e6b32; }
    .order-status-captured       { background:#e8f6ec; color:#1e6b32; }
    .order-status-authorized     { background:#e8f0fd; color:#1a4fa6; }

    /* ---- Timeline ---- */
    .adm-timeline { display: flex; flex-direction: column; }
    .adm-tl-row {
        position: relative;
        display: flex; justify-content: space-between; align-items: baseline; gap: 14px;
        padding: 0 0 16px 24px; font-size: 13px;
    }
    .adm-tl-row:last-child { padding-bottom: 0; }
    .adm-tl-row::before {
        content: ""; position: absolute; left: 0; top: 4px;
        width: 10px; height: 10px; border-radius: 50%;
        background: var(--a-surface); border: 2px solid var(--a-ink);
        box-sizing: border-box; z-index: 1;
    }
    .adm-tl-row::after {
        content: ""; position: absolute; left: 4px; top: 16px; bottom: -4px;
        width: 2px; background: var(--a-line);
    }
    .adm-tl-row:last-child::after { display: none; }
