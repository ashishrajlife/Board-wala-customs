@model ValousWorld.Web.Models.Entities.Product
@{ ViewData["Title"] = "New Product"; }

<div class="container admin-page">
    <h1>NEW PRODUCT</h1>
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <form method="post" action="/Admin/Products/Create" class="admin-form">
        @Html.AntiForgeryToken()

        <label>Name *</label>
        <input asp-for="Name" required placeholder="Product name" />

        <label>Slug (auto-generated if empty)</label>
        <input asp-for="Slug" placeholder="product-slug" />

        <label>Category *</label>
        <select asp-for="CategoryId" asp-items="ViewBag.Categories" required></select>

        <label>Short Description</label>
        <input asp-for="ShortDescription" placeholder="One-line summary" />

        <label>Full Description</label>
        <textarea asp-for="Description" rows="4" placeholder="Detailed description"></textarea>

        <div class="form-row">
            <div><label>MRP ₹ *</label><input asp-for="MRP" type="number" step="0.01" required /></div>
            <div><label>Sale Price ₹ *</label><input asp-for="SalePrice" type="number" step="0.01" required /></div>
        </div>

        <label>Sizes (comma separated)</label>
        <input asp-for="Sizes" placeholder="S,M,L,XL" />

        <label>Colors (comma separated)</label>
        <input asp-for="Colors" placeholder="Black,Brown" />

        <label>Primary Image URL *</label>
        <input asp-for="PrimaryImageUrl" required placeholder="https://..." />

        <label>Secondary Image URL</label>
        <input asp-for="SecondaryImageUrl" placeholder="https://..." />

        <div class="form-row">
            <div><label>Stock</label><input asp-for="Stock" type="number" min="0" /></div>
            <div><label>Display Order</label><input asp-for="DisplayOrder" type="number" min="0" /></div>
        </div>

        <div class="check-row">
            <label><input asp-for="IsActive" type="checkbox" /> Active</label>
            <label><input asp-for="IsFeatured" type="checkbox" /> Featured</label>
            <label><input asp-for="IsNewArrival" type="checkbox" /> New Arrival</label>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-primary">CREATE PRODUCT</button>
            <a href="/Admin/Products" class="btn-outline">CANCEL</a>
        </div>
    </form>
</div>