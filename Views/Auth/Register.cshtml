@model ValousWorld.Web.Models.ViewModels.RegisterViewModel
@{ ViewData["Title"] = "Register"; }

<div class="auth-card">
    <h2>Create Account</h2>

    <form asp-action="SendRegisterOtp" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label>Full Name *</label>
        <input asp-for="FullName" required />
        <span asp-validation-for="FullName" class="text-danger"></span>

        <label>Email *</label>
        <input asp-for="Email" type="email" required />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label>Phone *</label>
        <input asp-for="Phone" type="tel" placeholder="10-digit mobile" maxlength="10" required />
        <span asp-validation-for="Phone" class="text-danger"></span>

        <label>Password *</label>
        <input asp-for="Password" type="password" required />
        <span asp-validation-for="Password" class="text-danger"></span>

        <label>Confirm Password *</label>
        <input asp-for="ConfirmPassword" type="password" required />
        <span asp-validation-for="ConfirmPassword" class="text-danger"></span>

        <button type="submit" class="btn-primary" style="width:100%; margin-top:20px; padding:14px;">
            SEND OTP & VERIFY PHONE
        </button>
    </form>

    <p class="muted">Already have an account? <a href="/Auth/Login">Login</a></p>
</div>
<style>
    .auth-card {
        max-width: 450px;
        margin: 40px auto;
        padding: 30px;
    }

    .auth-card label {
        display: block;
        margin: 16px 0 7px;
        font-size: 14px;
        font-weight: 600;
        color: #222;
    }

    .auth-card input {
        width: 100%;
        height: 48px;
        padding: 0 14px;
        border: 1px solid #d6d6d6;
        border-radius: 8px;
        background: #fff;
        font-size: 15px;
        color: #222;
        outline: none;
        box-sizing: border-box;
        transition: all 0.2s ease;
    }

    .auth-card input::placeholder {
        color: #999;
    }

    .auth-card input:focus {
        border-color: #111;
        box-shadow: 0 0 0 3px rgba(0, 0, 0, 0.08);
    }

    .auth-card input:hover {
        border-color: #999;
    }

    .auth-card .text-danger {
        display: block;
        margin-top: 5px;
        font-size: 12px;
    }

    .auth-card .btn-primary {
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        letter-spacing: 0.3px;
        transition: 0.2s ease;
    }

    .auth-card .btn-primary:hover {
        opacity: 0.9;
        transform: translateY(-1px);
    }

    .auth-card .muted {
        text-align: center;
        margin-top: 22px;
        font-size: 14px;
    }

    .auth-card .muted a {
        font-weight: 600;
        color: #111;
        text-decoration: none;
    }

    .auth-card .muted a:hover {
        text-decoration: underline;
    }

    @@media (max-width: 480px) {
        .auth-card {
            margin: 20px 15px;
            padding: 24px 20px;
        }

        .auth-card input {
            height: 50px;
        }
    }
</style>