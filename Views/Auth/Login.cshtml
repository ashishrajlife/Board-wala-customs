@model ValousWorld.Web.Models.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Login"; }

<div class="auth-card">
    <h2>Login</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <label>Email</label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label>Password</label>
        <input asp-for="Password" type="password" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <label class="checkbox">
            <input asp-for="RememberMe" type="checkbox" /> Remember Me
        </label>

        <button type="submit" class="btn btn-primary">Login</button>
    </form>

    <p class="muted">Don't have an account? <a href="/Auth/Register">Register</a></p>
</div>