@model ValousWorld.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">

    @if (!ViewData.ModelState.IsValid &&
         ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="login-error-message">
         ⚠️ Invalid email or password. !
        </div>
    }

    <h2>Login</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <label>Email</label>
        <input asp-for="Email"
               type="email"
               class="@(ViewData.ModelState.IsValid ? "" : "login-error")" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label>Password</label>
        <input asp-for="Password"
               type="password"
               class="@(ViewData.ModelState.IsValid ? "" : "login-error")" />
        <span asp-validation-for="Password" class="text-danger"></span>

        <label class="checkbox">
            <input asp-for="RememberMe" type="checkbox" /> Remember Me
        </label>

        <button type="submit" class="btn btn-primary">Login</button>
    </form>

    <p class="muted">
        Don't have an account?
        <a href="/Auth/Register">Register</a>
    </p>
</div>
<style>
.auth-card {
    position: relative;
}

.login-error-message {
    position: absolute;
    top: 37px;
    right: 15px;
    color: red;
    padding: 7px 12px;
    font-size: 15px;
    font-weight: 600;
    z-index: 10;
}

.login-error {
    border: 1px solid #dc3545 !important;
}

.login-error:focus {
    border-color: #dc3545 !important;
    outline: none;
}
</style>
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const inputs = document.querySelectorAll(".login-error");
        const errorMessage = document.querySelector(".login-error-message");

        inputs.forEach(function (input) {
            input.addEventListener("input", function () {

                // Remove red border
                input.classList.remove("login-error");

                // Remove "Invalid email or password" message
                if (errorMessage) {
                    errorMessage.remove();
                }
            });
        });

    });
</script>