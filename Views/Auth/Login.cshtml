@model ValousWorld.Web.Models.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<div class="auth-card">

    @if (!ViewData.ModelState.IsValid &&
         ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="login-error-message">
         ⚠️ Invalid email or password. !
        </div>
    }

    <h2>Login</h2>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    <form asp-action="Login" method="post">
        @Html.AntiForgeryToken()

        <label>Email</label>
        <input asp-for="Email"
               type="email"
               class="@(ViewData.ModelState.IsValid ? "" : "login-error")" />
        <span asp-validation-for="Email" class="text-danger"></span>

        <label>Password</label>

        <div class="password-wrapper">
            <input asp-for="Password"
                   type="password"
                   id="passwordInput"
                   class="@(ViewData.ModelState.IsValid ? "" : "login-error")" />

            <button type="button"
                    class="password-toggle"
                    id="passwordToggle"
                    aria-label="Show password">
                    Show
            </button>
        </div>

        <span asp-validation-for="Password" class="text-danger"></span>

        <label class="checkbox">
            <input asp-for="RememberMe" type="checkbox" /> Remember Me
        </label>

        <button type="submit" class="btn btn-primary">Login</button>
    </form>

    <div style="text-align:center; margin: 20px 0;">
    <span style="color:#999; font-size:12px;">OR</span>
</div>

<a href="/auth/otp-login" class="btn-outline" style="width:100%; justify-content:center; display:inline-flex;">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="5" y="2" width="14" height="20" rx="2" ry="2"/>
        <line x1="12" y1="18" x2="12.01" y2="18"/>
    </svg>
    LOGIN WITH MOBILE OTP
</a>

    <p class="muted">
        Don't have an account?
        <a href="/Auth/Register">Register</a>
    </p>
</div>

<style>
.auth-card {
    position: relative;
}

.login-error-message {
    position: absolute;
    top: 37px;
    right: 15px;
    color: red;
    padding: 7px 12px;
    font-size: 15px;
    font-weight: 600;
    z-index: 10;
}

.login-error {
    border: 1px solid #dc3545 !important;
}

.login-error:focus {
    border-color: #dc3545 !important;
    outline: none;
}

/* Password eye button */
.password-wrapper {
    position: relative;
    width: 100%;
}

.password-wrapper input {
    width: 100%;
    padding-right: 45px;
}

.password-toggle {
    position: absolute;
    right: 10px;
    top: 50%;
    transform: translateY(-50%);
    border: none;
    background: transparent;
    padding: 0;
    margin: 0;
    cursor: pointer;
    font-size: 11px;
    line-height: 1;
    z-index: 2;
}

.password-toggle:focus {
    outline: none;
}
</style>

<script>
    document.addEventListener("DOMContentLoaded", function () {

        const inputs = document.querySelectorAll(".login-error");
        const errorMessage = document.querySelector(".login-error-message");

        inputs.forEach(function (input) {
            input.addEventListener("input", function () {

                // Remove red border
                input.classList.remove("login-error");

                // Remove "Invalid email or password" message
                if (errorMessage) {
                    errorMessage.remove();
                }
            });
        });

        // Password show/hide toggle
        const passwordInput = document.getElementById("passwordInput");
        const passwordToggle = document.getElementById("passwordToggle");

        passwordToggle.addEventListener("click", function () {

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                passwordToggle.textContent = "Hide";
                passwordToggle.setAttribute("aria-label", "Hide password");
            } else {
                passwordInput.type = "password";
                passwordToggle.textContent = "Show";
                passwordToggle.setAttribute("aria-label", "Show password");
            }

        });

    });
</script>