@using System.Text.Json
@{
    var items = new List<object>();
    foreach (var k in new[] { "Success", "ProductSuccess", "AddressSuccess","CartSuccess" })
        if (TempData[k] is string s && !string.IsNullOrWhiteSpace(s)) items.Add(new { type = "success", msg = s });
    foreach (var k in new[] { "Error", "ProductError", "AddressError", "CartError" })
        if (TempData[k] is string s && !string.IsNullOrWhiteSpace(s)) items.Add(new { type = "error", msg = s });
}

<div id="toastHost" class="toast-host" aria-live="polite"></div>

<style>
    .toast-host { position: fixed; top: 20px; right: 20px; z-index: 10000; display: flex; flex-direction: column; gap: 10px; pointer-events: none; }
    .toast {
        pointer-events: auto; display: flex; align-items: center; gap: 12px;
        min-width: 260px; max-width: 360px; padding: 14px 16px;
        background: var(--black); color: var(--white);
        font-size: 12px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
        box-shadow: 0 10px 30px rgba(0,0,0,.25);
        transform: translateX(120%); opacity: 0; transition: transform .35s ease, opacity .35s ease;
    }
    .toast.show { transform: translateX(0); opacity: 1; }
    .toast span { flex: 1; }
    .toast button { background: none; border: 0; color: inherit; font-size: 18px; line-height: 1; cursor: pointer; opacity: .7; }
    .toast button:hover { opacity: 1; }
    .toast-ico {
    flex: 0 0 22px; width: 22px; height: 22px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: #22c55e; color: #000;
    font-style: normal; font-size: 12px; font-weight: 900;
}
.toast.error .toast-ico   { background: var(--red, #e11d48); color: #fff; }
.toast.warning .toast-ico { background: #f59e0b; color: #000; }
    @@media (max-width: 500px) {
    .toast-host { top: 12px; right: 12px; left: auto; }
    .toast {
        min-width: 0;
        max-width: 240px;      /* change this to control the width */
        padding: 10px 12px;
        gap: 8px;
        font-size: 11px;
        letter-spacing: .5px;
    }
}
</style>

<script>
  window.showToast = function (msg, type) {
    type = type || 'success';                       // success | error | warning
    var icons = { success: '✓', error: '✕', warning: '!' };
    var host = document.getElementById('toastHost');
    var t = document.createElement('div');
    t.className = 'toast ' + type;
    var ico = document.createElement('i'); ico.className = 'toast-ico'; ico.textContent = icons[type] || '✓';
    var s = document.createElement('span'); s.textContent = msg;
    var b = document.createElement('button'); b.type = 'button'; b.innerHTML = '&times;';
    t.appendChild(ico); t.appendChild(s); t.appendChild(b); host.appendChild(t);
    function close() { t.classList.remove('show'); setTimeout(function () { t.remove(); }, 350); }
    b.addEventListener('click', close);
    requestAnimationFrame(function () { t.classList.add('show'); });
    setTimeout(close, 3500);
};
    const items = @Html.Raw(JsonSerializer.Serialize(items ?? []));

    items.forEach(function (i) {
        showToast(i.msg, i.type);
    });

</script>