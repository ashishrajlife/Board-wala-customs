    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
    .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1.4fr;   /* 4 columns */
    gap: 40px;
}

@@media (max-width: 1000px) {
    .footer-grid { grid-template-columns: repeat(2, 1fr); }
}
@@media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
}
    /* ============================================================
   DESKTOP HEADER — LOGO IMAGE + CENTERED BRAND
   ============================================================ */

@@media (min-width: 901px) {

    .site-header .header-inner {
        position: relative;
        min-height: 82px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        padding-left: 20px;
        padding-right: 20px;
    }

    /* LEFT LOGO IMAGE */
    .header-logo-image {
        position: absolute;
        left: 20px;
        top: 50%;
        transform: translateY(-50%);
        display: flex;
        align-items: center;
        z-index: 5;
    }

    .header-logo-image img {
        width: 58px;
        height: 58px;
        object-fit: contain;
        display: block;
    }

    /* CENTER TEXT LOGO */
    .site-header .brand-logo {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        margin: 0;
        z-index: 4;
    }

    /* RIGHT SIDE */
    .site-header .nav-right {
        margin-left: auto;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 18px;
        position: relative;
        z-index: 5;
    }

    /* DESKTOP SEARCH */
    .site-header .search-box {
        position: absolute;
        right: 100%;
        margin-right: 28px;
        top: 50%;
        transform: translateY(-50%);
        width: 240px;
        z-index: 5;
    }

    .site-header .search-box input {
        width: 100%;
        border:none;
    }

    /* Keep mobile search hidden on desktop */
    .site-header .mobile-search-btn {
        display: none;
    }
}

.socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    margin-right: 15px;
    height: 34px;
    border: 1px solid white;
    border-radius: 48%;
    transition: all 0.2s;
    color: #fff;        
}

.socials a:hover {
    border-color: #fff;
    background: rgba(255, 255, 255, 0.08);
}

.socials a svg {
    display: block;
    width: 20px;
    height: 20px;
    stroke: currentColor; 
}

/* ============================================================
   MOBILE HEADER
   Keep existing mobile behaviour
   ============================================================ */

@@media (max-width: 900px) {

    .header-logo-image {
        display: none;
    }

    .site-header .brand-logo {
        position: static;
        transform: none;
    }

    .site-header .search-box {
        display: none;
    }

    .site-header .mobile-search-btn {
        display: inline-flex;
    }
}

        /* ============================================================
   MOBILE SEARCH — Icon + Overlay
   ============================================================ */
        .mobile-search-btn {
            display: none;   /* hidden on desktop */
        }

        .mobile-search-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            background: var(--white);
            padding: 14px 16px;
            z-index: 900;
            box-shadow: 0 2px 12px rgba(0,0,0,0.08);
            border-bottom: 1px solid var(--gray-200);
        }

        .mobile-search-overlay.open {
            display: flex;
            align-items: center;
            gap: 10px;
            animation: slideDown 0.2s ease-out;
        }

        @@keyframes slideDown {
            from { transform: translateY(-100%); opacity: 0; }
            to   { transform: translateY(0); opacity: 1; }
        }

        .mobile-search-overlay form {
            flex: 1;
            display: flex;
            align-items: center;
            border: 1.5px solid var(--black);
            padding: 0 12px;
            height: 42px;
            background: var(--white);
        }

        .mobile-search-overlay input {
            flex: 1;
            border: none;
            outline: none;
            background: transparent;
            font-size: 14px;
            min-width: 0;
            font-family: inherit;
        }

        .mobile-search-overlay button[type=submit] {
            background: none;
            border: none;
            padding: 0;
            display: flex;
            align-items: center;
            color: var(--black);
            cursor: pointer;
        }

        .mobile-search-close {
            background: none;
            border: none;
            padding: 4px;
            cursor: pointer;
            color: var(--black);
            display: flex;
            align-items: center;
        }

        @@media (max-width: 900px) {
            .mobile-search-btn { display: inline-flex; }

            /* Hide desktop search box on mobile (already hidden) */
            .search-box { display: none; }
        }

        /* ============================================================
           NAV HOVER DROPDOWN
           ============================================================ */

        .nav-item {
            position: relative;
        }

        .nav-item > a {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .nav-dropdown {
            position: absolute;
            top: calc(100% + 15px);
            left: 50%;
            transform: translateX(-50%) translateY(-5px);

            min-width: 150px;
            padding: 18px 24px;

            background: #fff;
            border: 1px solid #e5e5e5;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.10);

            text-align: center;

            opacity: 0;
            visibility: hidden;
            pointer-events: none;

            transition: opacity 0.2s ease, transform 0.2s ease;
            z-index: 1000;
        }

        .nav-dropdown::before {
            content: "";
            position: absolute;
            top: -6px;
            left: 50%;
            width: 10px;
            height: 10px;

            background: #fff;
            border-left: 1px solid #e5e5e5;
            border-top: 1px solid #e5e5e5;

            transform: translateX(-50%) rotate(45deg);
        }

        .nav-item:hover .nav-dropdown {
            opacity: 1;
            visibility: visible;
            pointer-events: auto;
            transform: translateX(-50%) translateY(0);
        }

        .nav-dropdown span {
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
        }
    </style>
</head>
