@using Microsoft.EntityFrameworkCore
@inject ValousWorld.Web.Services.ICartService CartService
@inject ValousWorld.Web.Data.AppDbContext DbContext

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    var isAuthPage = string.Equals(currentController, "Auth", StringComparison.OrdinalIgnoreCase)
                     && (string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase)
                         || string.Equals(currentAction, "Register", StringComparison.OrdinalIgnoreCase));

    // Cart count
    int cartCount = 0;
    if (User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin"))
    {
        var idStr = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (int.TryParse(idStr, out var uid))
        {
            cartCount = await CartService.GetItemCountAsync(uid);
        }
    }

    // Footer categories — split into 2 columns
    var allCategories = await DbContext.Categories
        .Where(c => c.IsActive)
        .OrderBy(c => c.Name)
        .ToListAsync();

    var mid = (int)Math.Ceiling(allCategories.Count / 2.0);
    var footerCol1 = allCategories.Take(mid).ToList();
    var footerCol2 = allCategories.Skip(mid).ToList();
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
