            </svg>
        </button>
    </div>
}
    <!-- ============ ANNOUNCEMENT BAR ============ -->
   <div class="announcement-bar">
    <div class="marquee">
        @{
            var marqueeItems = await DbContext.Announcements
                .Where(a => a.IsActive)
                .OrderBy(a => a.DisplayOrder)
                .Select(a => a.Text)
                .ToListAsync();

            // Fallback — agar koi active announcement nahi hai
            if (!marqueeItems.Any())
            {
                marqueeItems.Add("✦ WELCOME TO VALOUSWORLD ✦");
            } 
        }

        @* Display twice for seamless scroll *@
        @foreach (var item in marqueeItems)
        {
            <span>@item</span>
        }
        @foreach (var item in marqueeItems)
        {
            <span>@item</span>
        }
    </div>
</div>

