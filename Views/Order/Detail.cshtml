@model ValousWorld.Web.Models.Entities.Order
@{
    ViewData["Title"] = "Order " + Model.OrderNumber;

        var canCancel = Model.Status != "Cancelled"
                 && Model.Status != "Delivered"
                 && Model.Status != "Refunded"
                 && Model.PaymentStatus != "Refunded";

    var isCod = Model.PaymentMethod == "COD";
    var isPaid = Model.PaymentStatus == "Paid";
}

<div class="container order-detail-page">

    @if (TempData["CancelSuccess"] != null)
    {
        <div class="alert-success">@TempData["CancelSuccess"]</div>
    }
    @if (TempData["CancelError"] != null)
    {
        <div class="alert-error">@TempData["CancelError"]</div>
    }

    <!-- ============ HEADER ============ -->
    <div class="order-detail-head">
        <h1>ORDER @Model.OrderNumber</h1>
        <div class="order-detail-actions">
            @if (canCancel)
            {
                <button type="button" class="btn-outline btn-cancel" id="cancelOrderBtn">
                    CANCEL ORDER
                </button>
            }
            <a href="/orders/invoice/@Model.OrderId" class="btn-primary" target="_blank" rel="noopener">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                    <polyline points="7 10 12 15 17 10"/>
                    <line x1="12" y1="15" x2="12" y2="3"/>
                </svg>
                DOWNLOAD INVOICE
            </a>
            <a href="/orders" class="btn-outline">← MY ORDERS</a>
        </div>
    </div>

    <div class="order-detail-grid">

        <!-- ============ LEFT COLUMN ============ -->
        <div class="order-detail-col">
            <div class="order-detail-card">
                <h3>ORDER STATUS</h3>
                <div class="order-detail-status-row">
                    <span class="order-status order-status-@Model.Status.ToLower()">@Model.Status</span>
                    <span class="order-detail-placed">Placed on @Model.PlacedAt.ToString("dd MMM yyyy, HH:mm")</span>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.TrackingNumber))
                {
                    <p class="order-detail-tracking"><strong>Tracking:</strong> @Model.CourierName — @Model.TrackingNumber</p>
                }
                @if (Model.Status == "Cancelled")
                {
                    <p class="order-detail-tracking order-detail-cancel">
                        <strong>Cancelled:</strong> @Model.CancelledAt?.ToString("dd MMM yyyy, HH:mm") by @Model.CancelledBy
                        @if (!string.IsNullOrWhiteSpace(Model.CancellationReason))
                        {
                            <br /><strong>Reason:</strong> @Model.CancellationReason
                        }
                    </p>
                }
            </div>

            <div class="order-detail-card">
                <h3>ITEMS (@Model.Items.Count)</h3>
                @foreach (var i in Model.Items)
                {
                    <div class="order-detail-item">
                        @if (!string.IsNullOrWhiteSpace(i.ProductImage))
                        {
                            <img src="@i.ProductImage" alt="@i.ProductName" loading="lazy" />
                        }
                        else
                        {
                            <div class="order-detail-noimg" aria-hidden="true"></div>
                        }
                        <div class="order-detail-item-info">
                            <p class="order-detail-item-name">@i.ProductName</p>
                            <p class="order-detail-item-meta">
                                @if (!string.IsNullOrWhiteSpace(i.Size)) { <span>Size: @i.Size</span> }
                                @if (!string.IsNullOrWhiteSpace(i.Color)) { <span>Color: @i.Color</span> }
                                <span>Qty: @i.Quantity</span>
                            </p>
                        </div>
                        <div class="order-detail-item-price">₹@i.LineTotal.ToString("0.00")</div>
                    </div>
                }
            </div>
        </div>

        <!-- ============ RIGHT COLUMN ============ -->
        <div class="order-detail-col">
            <div class="order-detail-card">
                <h3>SHIPPING ADDRESS</h3>
                <p><strong>@Model.ShippingFullName</strong></p>
                <p>📞 @Model.ShippingPhone</p>
                <p>@Model.ShippingLine1</p>
                @if (!string.IsNullOrWhiteSpace(Model.ShippingLine2))
                {
                    <p>@Model.ShippingLine2</p>
                }
                <p>@Model.ShippingCity, @Model.ShippingState — @Model.ShippingPincode</p>
                <p>@Model.ShippingCountry</p>
            </div>

            <div class="order-detail-card">
                <h3>PAYMENT SUMMARY</h3>
                <div class="os-row"><span>Subtotal</span><span>₹@Model.Subtotal.ToString("0.00")</span></div>
                @if (Model.Discount > 0)
                {
                    <div class="os-row os-row-save"><span>Savings</span><span>−₹@Model.Discount.ToString("0.00")</span></div>
                }
                <div class="os-row"><span>Shipping</span><span>₹@Model.Shipping.ToString("0.00")</span></div>
                @if (Model.CodFee > 0)
                {
                    <div class="os-row"><span>COD handling</span><span>₹@Model.CodFee.ToString("0.00")</span></div>
                }
                <div class="os-row os-row-total"><span>TOTAL</span><span>₹@Model.Total.ToString("0.00")</span></div>
                <div class="os-row os-row-meta"><span>Method</span><span>@(isCod ? "Cash on Delivery" : Model.PaymentMethod)</span></div>
                <div class="os-row os-row-meta"><span>Status</span><span>@Model.PaymentStatus</span></div>

                @if (!string.IsNullOrWhiteSpace(Model.RefundId))
                {
                    <div class="os-row os-row-meta">
                        <span>Refund</span>
                        <span>₹@Model.RefundedAmount?.ToString("0.00") — @Model.RefundStatus</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (canCancel)
{
    <div class="confirm-overlay" id="cancelOrderModal" aria-hidden="true">
        <div class="confirm-box" role="dialog" aria-modal="true" aria-labelledby="cancelTitle">
            <h4 id="cancelTitle">Cancel this order?</h4>
            <form method="post" action="/orders/cancel/@Model.OrderId" id="cancelForm">
                @Html.AntiForgeryToken()
                <p>Please select a reason. This action cannot be undone.</p>

                <select name="reason" required class="cancel-reason">
                    <option value="">Select a reason…</option>
                    <option value="Ordered by mistake">Ordered by mistake</option>
                    <option value="Found a better price">Found a better price</option>
                    <option value="Delivery taking too long">Delivery taking too long</option>
                    <option value="Changed my mind">Changed my mind</option>
                    <option value="Other">Other</option>
                </select>

                @if (isPaid)
                {
                    <p class="refund-note">
                        A refund of <strong>₹@Model.Total.ToString("0.00")</strong> will be initiated to your original payment method. It usually reflects in 5–7 business days.
                    </p>
                }

                <div class="confirm-actions">
                    <button type="button" class="confirm-btn confirm-btn-ghost" id="cancelModalClose">KEEP ORDER</button>
                    <button type="submit" class="confirm-btn confirm-btn-danger">YES, CANCEL</button>
                </div>
            </form>
        </div>
    </div>
}

<style>
    .order-detail-page { padding: 50px 50px 50px; }

    .alert-success, .alert-error {
        border-radius: 4px;
        padding: 12px 16px;
        font-size: 13px;
        margin-bottom: 18px;
    }
    .alert-success { background: #e8f5e9; color: #2e7d32; border: 1px solid #a5d6a7; }
    .alert-error   { background: #fdecea; color: #b71c1c; border: 1px solid #f5c2c0; }

    /* ---------- Header ---------- */
    .order-detail-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 18px;
    }
    .order-detail-head h1 {
        font-size: clamp(15px, 2.6vw, 18px);
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
        min-width: 0;
        overflow-wrap: anywhere;
    }
    .order-detail-actions {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .order-detail-actions .btn-primary,
    .order-detail-actions .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        white-space: nowrap;
        font-size: 11px;
        padding: 9px 14px;
    }
    .btn-cancel { color: #b71c1c; border-color: #b71c1c; }
    .btn-cancel:hover { background: #b71c1c; color: #fff; }

    /* ---------- Layout ---------- */
    .order-detail-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 320px;
        gap: 16px;
        align-items: start;
    }
    .order-detail-col {
        display: flex;
        flex-direction: column;
        gap: 12px;
        min-width: 0;
    }

    /* ---------- Cards ---------- */
    .order-detail-card {
        border: 1px solid black;
        border-radius: 4px;
        padding: 14px 16px;
        background: var(--white);
    }
    .order-detail-card h3 {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--gray-600);
        margin: 0 0 10px;
        padding-bottom: 10px;
        border-bottom: 1px solid black;
    }
    .order-detail-card p {
        font-size: 12.5px;
        line-height: 1.55;
        margin: 3px 0;
        color: var(--gray-800);
        overflow-wrap: anywhere;
    }

    /* Status */
    .order-detail-status-row {
        display: flex;
        align-items: center;
        gap: 8px 12px;
        flex-wrap: wrap;
    }
    .order-detail-placed { font-size: 12px; color: var(--gray-600); }
    .order-detail-tracking {
        margin-top: 10px !important;
        padding: 8px 10px;
        background: var(--gray-100);
        border-radius: 3px;
        font-size: 12px !important;
    }
    .order-detail-cancel {
        background: #fdecea;
        color: #7a1f1f;
    }
    .order-status {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        padding: 4px 9px;
        border-radius: 20px;
        white-space: nowrap;
    }
    .order-status-created        { background: #f5f5f5; color: #424242; }
    .order-status-paymentpending { background: #fff8e1; color: #7c5700; }
    .order-status-pending        { background: #fff8e1; color: #7c5700; }
    .order-status-confirmed      { background: #e3f2fd; color: #0d47a1; }
    .order-status-shipped        { background: #f3e5f5; color: #6a1b9a; }
    .order-status-delivered      { background: #e8f5e9; color: #2e7d32; }
    .order-status-cancelled      { background: #fdecea; color: #b71c1c; }
    .order-status-failed         { background: #fdecea; color: #b71c1c; }
    .order-status-expired        { background: #eceff1; color: #455a64; }
    .order-status-refunded       { background: #e0f2f1; color: #00695c; }
    .order-status-returned       { background: #fff3e0; color: #e65100; }

    /* Items */
    .order-detail-item {
        display: grid;
        grid-template-columns: 48px minmax(0, 1fr) auto;
        gap: 12px;
        align-items: center;
        padding: 10px 0;
        border-bottom: 1px solid var(--gray-200);
    }
    .order-detail-item:first-of-type { padding-top: 2px; }
    .order-detail-item:last-child { border-bottom: none; padding-bottom: 0; }
    .order-detail-item img,
    .order-detail-noimg {
        width: 48px;
        height: 60px;
        object-fit: cover;
        border-radius: 3px;
        background: var(--gray-100);
    }
    .order-detail-item-name {
        font-size: 11.5px;
        font-weight: 700;
        text-transform: uppercase;
        margin: 0 0 3px !important;
        line-height: 1.35;
    }
    .order-detail-item-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 2px 10px;
        font-size: 10.5px !important;
        color: var(--gray-600) !important;
        margin: 0 !important;
        text-transform: uppercase;
        letter-spacing: 0.2px;
    }
    .order-detail-item-price {
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* Payment rows */
    .os-row {
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 5px 0;
        font-size: 12.5px;
    }
    .os-row span:last-child { text-align: right; overflow-wrap: anywhere; }
    .os-row-save { color: #2e7d32; font-weight: 600; }
    .os-row-total {
        padding-top: 10px;
        margin-top: 6px;
        border-top: 1px solid var(--black);
        font-size: 14px;
        font-weight: 800;
    }
    .os-row-meta { font-size: 11.5px; color: var(--gray-600); }

    /* Cancel modal */
    .confirm-overlay {
        position: fixed; inset: 0; background: rgba(0,0,0,.6);
        display: none; align-items: center; justify-content: center;
        padding: 20px; z-index: 9999;
    }
    .confirm-overlay.open { display: flex; }
    .confirm-box {
        background: var(--white); border: 1px solid var(--black); border-radius: 4px;
        width: 100%; max-width: 460px; overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }
    .confirm-box h4 {
        margin: 0; padding: 14px 20px;
        font-size: 12px; font-weight: 800; letter-spacing: 1.5px; text-transform: uppercase;
        background: var(--gray-100); border-bottom: 1px solid var(--gray-200);
    }
    .confirm-box p { margin: 0; padding: 12px 20px 0; font-size: 13px; color: var(--gray-800); line-height: 1.6; }
    .cancel-reason {
        display: block;
        width: calc(100% - 40px);
        margin: 12px 20px 0;
        padding: 10px 12px;
        border: 1.5px solid var(--gray-200);
        border-radius: 3px;
        font-family: inherit;
        font-size: 13px;
    }
    .refund-note {
        color: #7a1f1f !important;
        background: #fdecea;
        border-radius: 3px;
        padding: 10px 12px !important;
        margin: 14px 20px 0 !important;
        font-size: 12px !important;
    }
    .confirm-actions { display: flex; gap: 10px; justify-content: flex-end; padding: 16px 20px 20px; }
    .confirm-btn {
        min-width: 110px; height: 38px; padding: 0 14px;
        font-family: inherit; font-size: 11px; font-weight: 700;
        letter-spacing: 1px; text-transform: uppercase;
        border: 1.5px solid var(--black); border-radius: 3px; cursor: pointer;
        transition: background .2s, color .2s, opacity .2s;
    }
    .confirm-btn-ghost { background: transparent; color: var(--black); }
    .confirm-btn-ghost:hover { background: var(--black); color: var(--white); }
    .confirm-btn-danger { background: #b71c1c; border-color: #b71c1c; color: var(--white); }
    .confirm-btn-danger:hover { opacity: .85; }

    /* ---------- Tablet ---------- */
    @@media (max-width: 1024px) {
        .order-detail-grid { grid-template-columns: minmax(0, 1fr) 300px; gap: 14px; }
    }
    @@media (max-width: 900px) {
        .order-detail-page { padding: 22px var(--container-pad, 20px) 44px; }
        .order-detail-grid { grid-template-columns: minmax(0, 1fr); }
    }
    @@media (max-width: 600px) {
        .order-detail-page { padding: 18px var(--container-pad, 16px) 36px; }
        .order-detail-head { flex-direction: column; align-items: stretch; gap: 12px; }
        .order-detail-actions { flex-direction: column-reverse; }
        .order-detail-actions .btn-primary,
        .order-detail-actions .btn-outline,
        .order-detail-actions .btn-cancel { width: 100%; }

        .order-detail-card { padding: 13px 14px; }
        .order-detail-item { grid-template-columns: 44px minmax(0, 1fr); gap: 10px; }
        .order-detail-item img,
        .order-detail-noimg { width: 44px; height: 56px; }
        .order-detail-item-price { grid-column: 2; }
    }
</style>

<script>
    (function () {
        const modal = document.getElementById('cancelOrderModal');
        const openBtn = document.getElementById('cancelOrderBtn');
        if (!modal || !openBtn) return;

        const closeBtn = document.getElementById('cancelModalClose');

        openBtn.addEventListener('click', () => {
            modal.classList.add('open');
            modal.setAttribute('aria-hidden', 'false');
        });
        closeBtn.addEventListener('click', () => {
            modal.classList.remove('open');
            modal.setAttribute('aria-hidden', 'true');
        });
        modal.addEventListener('click', e => {
            if (e.target === modal) {
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
            }
        });
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && modal.classList.contains('open')) {
                modal.classList.remove('open');
                modal.setAttribute('aria-hidden', 'true');
            }
        });
    })();
</script>