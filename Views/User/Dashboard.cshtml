@model List<ValousWorld.Web.Models.Entities.Order>
@{
    ViewData["Title"] = "My Dashboard";
    var totalOrders = Model?.Count ?? 0;
    var totalSpent = Model?.Sum(o => o.Total) ?? 0m;
    var activeOrders = Model?.Count(o => o.Status != "Delivered" && o.Status != "Cancelled") ?? 0;
}

<div class="container dashboard-page">
    <h1>WELCOME, @User.Identity?.Name</h1>
    <p class="dashboard-welcome">This is your personal VALOUSWORLD dashboard.</p>

    <!-- ============ QUICK STATS ============ -->
    <div class="user-stats-grid">
        <a href="/orders" class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <h3>My Orders</h3>
            <p class="user-stat-number">@totalOrders</p>
            <span class="user-stat-link">View all →</span>
        </a>

        <div class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
            </div>
            <h3>Total Spent</h3>
            <p class="user-stat-number">₹@totalSpent.ToString("0")</p>
            <span class="user-stat-link">Lifetime</span>
        </div>

        <div class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <h3>Active Orders</h3>
            <p class="user-stat-number">@activeOrders</p>
            <span class="user-stat-link">In transit</span>
        </div>

        <a href="/address" class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
            </div>
            <h3>Addresses</h3>
            <p class="user-stat-number">Manage</p>
            <span class="user-stat-link">Add / edit →</span>
        </a>
    </div>

    <!-- ============ RECENT ORDERS ============ -->
    @if (Model != null && Model.Any())
    {
        <div class="user-section">
            <div class="user-section-head">
                <h2>RECENT ORDERS</h2>
                <a href="/orders" class="user-section-link">VIEW ALL →</a>
            </div>

            <div class="user-orders">
                @foreach (var o in Model.Take(5))
                {
                    <a href="/orders/@o.OrderId" class="user-order-card">
                        <div class="user-order-left">
                            <p class="user-order-num">@o.OrderNumber</p>
                            <p class="user-order-date">@o.PlacedAt.ToString("dd MMM yyyy")</p>
                        </div>

                        <div class="user-order-middle">
                            <p class="user-order-items">@(o.Items?.Count ?? 0) item@((o.Items?.Count ?? 0) == 1 ? "" : "s")</p>
                            <p class="user-order-total">₹@o.Total.ToString("0.00")</p>
                        </div>

                        <div class="user-order-right">
                            <span class="order-status order-status-@o.Status.ToLower()">@o.Status</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="user-empty">
            <div class="user-empty-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <h2>No orders yet</h2>
            <p>Start shopping and your orders will appear here.</p>
            <a href="/shop" class="btn-primary">START SHOPPING</a>
        </div>
    }
</div>

<style>
    .dashboard-page { padding: 40px 0 80px; }
    .dashboard-page h1 {
        font-size: 26px;
        font-weight: 900;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin: 0 0 6px;
    }
    .dashboard-welcome {
        font-size: 13px;
        color: var(--gray-600);
        margin: 0 0 32px;
    }

    /* ---------- Stats Grid ---------- */
    .user-stats-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-bottom: 40px;
    }

    .user-stat-card {
        display: flex;
        flex-direction: column;
        gap: 6px;
        padding: 20px;
        background: var(--white);
        border: 1.5px solid var(--gray-200);
        border-radius: 6px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, transform 0.15s;
    }
    a.user-stat-card:hover {
        border-color: var(--black);
        transform: translateY(-2px);
    }

    .user-stat-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: var(--gray-100);
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 4px;
        color: var(--black);
    }

    .user-stat-card h3 {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: var(--gray-600);
        margin: 0;
    }
    .user-stat-number {
        font-size: 24px;
        font-weight: 900;
        color: var(--black);
        margin: 0;
        line-height: 1;
    }
    .user-stat-link {
        font-size: 11px;
        font-weight: 600;
        color: var(--gray-600);
        letter-spacing: 0.5px;
        margin-top: 4px;
    }

    /* ---------- Orders Section ---------- */
    .user-section { margin-top: 20px; }
    .user-section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 2px solid var(--black);
    }
    .user-section-head h2 {
        font-size: 15px;
        font-weight: 900;
        letter-spacing: 1.5px;
        text-transform: uppercase;
        margin: 0;
    }
    .user-section-link {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: var(--black);
        text-decoration: underline;
    }

    .user-orders { display: flex; flex-direction: column; gap: 10px; }

    .user-order-card {
        display: grid;
        grid-template-columns: 1fr 1fr auto;
        gap: 20px;
        align-items: center;
        padding: 16px 20px;
        background: var(--white);
        border: 1.5px solid var(--gray-200);
        border-radius: 4px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s;
    }
    .user-order-card:hover { border-color: var(--black); }

    .user-order-num {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 0.5px;
        margin: 0 0 3px;
    }
    .user-order-date {
        font-size: 12px;
        color: var(--gray-600);
        margin: 0;
    }

    .user-order-middle { text-align: right; }
    .user-order-items {
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--gray-600);
        margin: 0 0 3px;
    }
    .user-order-total {
        font-size: 14px;
        font-weight: 800;
        color: var(--red);
        margin: 0;
    }

    /* Order Status Badges */
    .order-status {
        display: inline-block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: 5px 10px;
        border-radius: 2px;
    }
    .order-status-pending { background: #fff8e1; color: #7c5700; }
    .order-status-confirmed { background: #e3f2fd; color: #0d47a1; }
    .order-status-shipped { background: #f3e5f5; color: #6a1b9a; }
    .order-status-delivered { background: #e8f5e9; color: #2e7d32; }
    .order-status-cancelled { background: #fdecea; color: #b71c1c; }

    /* ---------- Empty State ---------- */
    .user-empty {
        text-align: center;
        padding: 60px 20px;
        border: 1.5px solid var(--gray-200);
        border-radius: 6px;
        margin-top: 20px;
    }
    .user-empty-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: var(--gray-100);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-400);
        margin-bottom: 16px;
    }
    .user-empty h2 {
        font-size: 18px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin: 0 0 6px;
    }
    .user-empty p {
        font-size: 13px;
        color: var(--gray-600);
        margin: 0 0 20px;
    }

    /* ---------- Responsive ---------- */
    @@media (max-width: 768px) {
        .dashboard-page { padding: 24px 0 60px; }
        .dashboard-page h1 { font-size: 20px; }
        .user-stats-grid { grid-template-columns: repeat(2, 1fr); gap: 10px; }
        .user-stat-card { padding: 14px; }
        .user-stat-number { font-size: 20px; }

        .user-order-card {
            grid-template-columns: 1fr auto;
            gap: 12px;
            padding: 14px;
        }
        .user-order-middle {
            grid-column: 1;
            text-align: left;
            display: flex;
            gap: 10px;
            align-items: center;
        }
        .user-order-right {
            grid-column: 2;
            grid-row: 1 / 3;
            display: flex;
            align-items: center;
        }
    }

    @@media (max-width: 500px) {
        .user-stats-grid { grid-template-columns: 1fr; }
    }
</style>