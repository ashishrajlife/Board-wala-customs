@model List<ValousWorld.Web.Models.Entities.Order>
@{
    ViewData["Title"] = "My Dashboard";
    var totalOrders = Model?.Count ?? 0;
    var activeOrders = Model?.Count(o => o.Status != "Delivered" && o.Status != "Cancelled") ?? 0;
}

    <div class="container dashboard-page">
        <div class="dashboard-top">
        <h1>WELCOME, @User.Identity?.Name</h1>
        <a href="/" class="btn-outline dashboard-back">← BACK</a>
    </div>

    <!-- ============ QUICK STATS ============ -->
    <div class="user-stats-grid">
        <a href="/orders" class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <div class="user-stat-body">
                <h3>My Orders</h3>
                <p class="user-stat-number">@totalOrders</p>
                <span class="user-stat-link">View all →</span>
            </div>
        </a>

        <div class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                </svg>
            </div>
            <div class="user-stat-body">
                <h3>Active Orders</h3>
                <p class="user-stat-number">@activeOrders</p>
                <span class="user-stat-link">In transit</span>
            </div>
        </div>

        <a href="/address" class="user-stat-card">
            <div class="user-stat-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/>
                    <circle cx="12" cy="10" r="3"/>
                </svg>
            </div>
            <div class="user-stat-body">
                <h3>Addresses</h3>
                <p class="user-stat-number">Manage →</p>
                <span class="user-stat-link">Add / edit →</span>
            </div>
        </a>
    </div>

    <!-- ============ RECENT ORDERS ============ -->
    @if (Model != null && Model.Any())
    {
        <div class="user-section">
            <div class="user-section-head">
                <h2>RECENT ORDERS</h2>
                <a href="/orders" class="user-section-link">VIEW ALL →</a>
            </div>

            <div class="user-orders">
                @foreach (var o in Model.Take(5))
                {
                    <a href="/orders/@o.OrderId" class="user-order-card">
                        <div class="user-order-left">
                            <p class="user-order-num">@o.OrderNumber</p>
                            <p class="user-order-date">@o.PlacedAt.ToString("dd MMM yyyy")</p>
                        </div>

                        <div class="user-order-middle">
                            <p class="user-order-items">@(o.Items?.Count ?? 0) item@((o.Items?.Count ?? 0) == 1 ? "" : "s")</p>
                            <p class="user-order-total">₹@o.Total.ToString("0.00")</p>
                        </div>

                        <div class="user-order-right">
                            <span class="order-status order-status-@o.Status.ToLower()">@o.Status</span>
                        </div>
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="user-empty">
            <div class="user-empty-icon">
                <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                    <line x1="3" y1="6" x2="21" y2="6"/>
                    <path d="M16 10a4 4 0 0 1-8 0"/>
                </svg>
            </div>
            <h2>No orders yet</h2>
            <p>Start shopping and your orders will appear here.</p>
            <a href="/shop" class="btn-primary">START SHOPPING</a>
        </div>
    }
</div>

<style>
    .dashboard-page { padding: 32px var(--container-pad, 20px) 64px; }
    .dashboard-page h1 {
        font-size: clamp(18px, 3.2vw, 22px);
        font-weight: 800;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        margin: 0 0 4px;
        overflow-wrap: anywhere;
    }
    .dashboard-welcome {
        font-size: 13px;
        color: var(--gray-600);
        margin: 0 0 24px;
    }

    /* ---------- Stats Grid (3 cards, compact & horizontal) ---------- */
    .user-stats-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 32px;
    }

    .user-stat-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        min-width: 0;
        background: var(--white);
        border: 1px solid black;
        border-radius: 4px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, background 0.15s;
    }
    a.user-stat-card:hover,
    a.user-stat-card:focus-visible {
        border-color: var(--gray-400);
        background: var(--gray-100);
        outline: none;
    }

    .user-stat-icon {
        width: 34px;
        height: 34px;
        flex-shrink: 0;
        border-radius: 50%;
        background: var(--gray-100);
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--black);
    }
    .user-stat-icon svg { width: 16px; height: 16px; }

    .user-stat-body { display: flex; flex-direction: column; gap: 1px; min-width: 0; }
    .user-stat-card h3 {
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.8px;
        text-transform: uppercase;
        color: var(--gray-600);
        margin: 0;
    }
    .user-stat-number {
        font-size: 17px;
        font-weight: 800;
        color: var(--black);
        margin: 0;
        line-height: 1.3;
    }
    .user-stat-link { display: none; }

    /* ---------- Orders Section ---------- */
    .user-section { margin-top: 8px; }
    .user-section-head {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 12px;
        margin-bottom: 12px;
        padding-bottom: 10px;
        border-bottom: 1px solid var(--gray-200);
    }
    .user-section-head h2 {
        font-size: 13px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        margin: 0;
    }
    .user-section-link {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--gray-600);
        text-decoration: none;
        white-space: nowrap;
    }
    .user-section-link:hover { color: var(--black); text-decoration: underline; }

    .user-orders { display: flex; flex-direction: column; gap: 8px; }

    .user-order-card {
        display: grid;
        grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr) auto;
        grid-template-areas: "left middle right";
        gap: 16px;
        align-items: center;
        padding: 12px 16px;
        background: var(--white);
        border: 1px solid black;
        border-radius: 4px;
        text-decoration: none;
        color: inherit;
        transition: border-color 0.15s, background 0.15s;
    }
    .user-order-card:hover,
    .user-order-card:focus-visible {
        border-color: var(--gray-400);
        background: var(--gray-100);
        outline: none;
    }
    .user-order-left   { grid-area: left;   min-width: 0; }
    .user-order-middle { grid-area: middle; min-width: 0; text-align: right; }
    .user-order-right  { grid-area: right;  display: flex; justify-content: flex-end; }

    .user-order-num {
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0.3px;
        margin: 0 0 2px;
        overflow-wrap: anywhere;
    }
    .user-order-date {
        font-size: 11px;
        color: var(--gray-600);
        margin: 0;
    }
    .user-order-items {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: var(--gray-600);
        margin: 0 0 2px;
    }
    .user-order-total {
        font-size: 13px;
        font-weight: 700;
        color: var(--black);
        margin: 0;
    }

    /* Order Status Badges */
    .order-status {
        display: inline-block;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 0.6px;
        text-transform: uppercase;
        padding: 4px 9px;
        border-radius: 20px;
        white-space: nowrap;
    }
    .order-status-pending   { background: #fff8e1; color: #7c5700; }
    .order-status-confirmed { background: #e3f2fd; color: #0d47a1; }
    .order-status-shipped   { background: #f3e5f5; color: #6a1b9a; }
    .order-status-delivered { background: #e8f5e9; color: #2e7d32; }
    .order-status-cancelled { background: #fdecea; color: #b71c1c; }

    /* ---------- Empty State ---------- */
    .user-empty {
        text-align: center;
        padding: 48px 20px;
        border: 1px solid var(--gray-200);
        border-radius: 4px;
        margin-top: 16px;
    }
    .user-empty-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--gray-100);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--gray-400);
        margin-bottom: 14px;
    }
    .user-empty-icon svg { width: 26px; height: 26px; }
    .user-empty h2 {
        font-size: 15px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        margin: 0 0 6px;
    }
    .user-empty p {
        font-size: 13px;
        color: var(--gray-600);
        margin: 0 0 18px;
    }

    /* ---------- Tablet ---------- */
    @@media (max-width: 900px) {
        .dashboard-page { padding: 26px var(--container-pad, 20px) 52px; }
    }

    /* ---------- Mobile ---------- */
    @@media (max-width: 640px) {
        .dashboard-page { padding: 20px var(--container-pad, 16px) 40px; }
        .dashboard-welcome { margin-bottom: 20px; }

        .user-stats-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; margin-bottom: 24px; }
        .user-stat-card {
            flex-direction: column;
            text-align: center;
            gap: 6px;
            padding: 12px 8px;
        }
        .user-stat-icon { width: 30px; height: 30px; }
        .user-stat-icon svg { width: 14px; height: 14px; }
        .user-stat-body { align-items: center; }
        .user-stat-card h3 { font-size: 9px; letter-spacing: 0.4px; }
        .user-stat-number { font-size: 15px; }

        /* order card: number + status on top, items + total below */
        .user-order-card {
            grid-template-columns: minmax(0, 1fr) auto;
            grid-template-areas:
                "left   right"
                "middle middle";
            gap: 8px 12px;
            padding: 12px 14px;
            align-items: start;
        }
        .user-order-right { align-self: start; }
        .user-order-middle {
            text-align: left;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-top: 8px;
            border-top: 1px solid var(--gray-200);
        }
        .user-order-items, .user-order-total { margin: 0; }
    }

        @@media (max-width: 360px) {
            .user-section-head { flex-wrap: wrap; }
            .user-stat-card h3 { font-size: 8px; letter-spacing: 0.2px; }
            .user-stat-number { font-size: 13px; }
        }
        .dashboard-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
        margin: 25px;
        margin-bottom: 4px;
    }
    .dashboard-top h1 {
        margin: 0;          /* the wrapper handles the spacing now */
        min-width: 0;       /* lets long usernames wrap instead of pushing the button off */
    }
    .dashboard-back {
        flex-shrink: 0;     /* button never gets squished */
        white-space: nowrap;
        font-size: 11px;    /* optional: slightly smaller so it fits on mobile */
        padding: 6px 12px;  /* optional: adjust to match your design */
    }
</style>
