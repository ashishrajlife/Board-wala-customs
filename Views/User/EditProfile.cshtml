@model ValousWorld.Web.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container dashboard-page" style="max-width: 600px;">
    <div class="dashboard-top">
        <h1>EDIT PROFILE</h1>
        <a href="/User/Dashboard" class="btn-outline dashboard-back">← BACK</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    <div class="user-stat-card" style="display: block; padding: 30px;">
        <form method="post" asp-action="EditProfile">
            @Html.AntiForgeryToken()

            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Full Name</label>
                <input asp-for="FullName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div style="margin-bottom: 30px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Phone Number</label>
                <input asp-for="Phone" type="text" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; padding: 14px;">
                SAVE CHANGES
            </button>
        </form>
    </div>
</div>