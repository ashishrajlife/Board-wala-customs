@model ValousWorld.Web.Models.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="container dashboard-page" style="max-width: 600px;">
    <div class="dashboard-top">
        <h1>EDIT PROFILE</h1>
        <a href="/User/Dashboard" class="btn-outline dashboard-back">← BACK</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert-success">@TempData["Success"]</div>
    }

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
    {
        <div class="alert-error">@ViewData.ModelState[string.Empty]?.Errors.First().ErrorMessage</div>
    }

    <div class="user-stat-card" style="display: block; padding: 30px;">
        <form method="post" asp-action="EditProfile">
            @Html.AntiForgeryToken()
            
            <input type="hidden" name="actionType" id="actionType" value="Save" />

            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Full Name</label>
                <input asp-for="FullName" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Email Address</label>
                <input asp-for="Email" type="email" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">Phone Number</label>
                <input asp-for="Phone" type="text" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="Phone" class="text-danger"></span>
            </div>

            <!-- OTP SECTION -->
            @if (Model.IsOtpSent)
            {
                <div style="margin-bottom: 20px; padding: 15px; background: #fff8e1; border: 1px solid #ffecb3; border-radius: 4px;">
                    <label style="font-weight: 700; font-size: 12px; color: #7c5700; text-transform: uppercase;">Enter OTP</label>
                    <p style="font-size: 12px; color: #7c5700; margin: 5px 0 10px;">We sent an OTP to your new phone number. <strong>(For Demo, use: 1234)</strong></p>
                    <input asp-for="OtpCode" class="form-control" placeholder="Enter 4-digit OTP (1234)" style="width: 100%; padding: 10px; border: 1px solid #ccc;" />
                    <span asp-validation-for="OtpCode" class="text-danger"></span>
                </div>
            }

            <!-- Password Section -->
            <div style="margin-bottom: 20px; padding-top: 20px; border-top: 1px dashed #ccc;">
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase;">New Password (Optional)</label>
                <!-- Yahan type="password" ko hata kar type="text" kar diya hai -->
                <input asp-for="NewPassword" type="text" placeholder="Leave blank to keep current" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                
                <label style="font-weight: 700; font-size: 12px; text-transform: uppercase; margin-top: 15px; display: block;">Confirm New Password</label>
                <!-- Yahan bhi type="text" kar diya hai -->
                <input asp-for="ConfirmPassword" type="text" placeholder="Confirm new password" class="form-control" style="width: 100%; padding: 10px; border: 1px solid #ccc; margin-top: 5px;" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <!-- Buttons -->
            <div style="display: flex; gap: 10px; flex-wrap: wrap;">
                @if (!Model.IsOtpSent)
                {
                    <button type="submit" class="btn-outline" style="flex: 1; justify-content: center; padding: 14px;" onclick="document.getElementById('actionType').value='SendOtp'">
                        SEND OTP TO UPDATE
                    </button>
                }
                
                <button type="submit" class="btn-primary" style="flex: 1; justify-content: center; padding: 14px;" onclick="document.getElementById('actionType').value='Save'">
                    @(Model.IsOtpSent ? "VERIFY & SAVE" : "SAVE CHANGES")
                </button>
            </div>
        </form>
    </div>
</div>