@model ValousWorld.Web.Models.Entities.Product
@{
    ViewData["Title"] = Model.Name;
    ViewData["Breadcrumb"] = Html.Raw(
        $"<a href='/'>Home</a> / <a href='/category/{Model.Category?.CategoryId}'>{Model.Category?.Name}</a> / <span>{Model.Name}</span>");

    var related = ViewBag.Related as List<ValousWorld.Web.Models.Entities.Product> ?? new();

    var galleryImgs = new[] { Model.Image1, Model.Image2, Model.Image3, Model.Image4 }
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .ToList();

    var sizes = (Model.Sizes ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var colors = (Model.Colors ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var tags = (Model.Tags ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();

    var benefits = (Model.Benefits ?? "")
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .ToList();
}

<!-- ================= Back Button ================= -->
<div class="container">
    <a href="javascript:history.back()" class="pdp-back-btn">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="19" y1="12" x2="5" y2="12"/>
            <polyline points="12 19 5 12 12 5"/>
        </svg>
        BACK
    </a>
</div>

<section class="product-detail">
    <div class="container pdp-grid">

        <!-- ================= LEFT: Gallery ================= -->
        <div class="pdp-gallery">
            @if (galleryImgs.Any())
            {
                <div class="pdp-main-wrap" id="pdpSlider">
                    <img id="pdpMainImg"
                         src="@galleryImgs.First()"
                         alt="@Model.Name"
                         class="pdp-main"
                         data-current="0"
                         data-total="@galleryImgs.Count" />

                    @if (Model.SavePercent > 0 && Model.SalePrice.HasValue && Model.SalePrice.Value > 0 && Model.SalePrice.Value < Model.MRP)
                    {
                        <span class="pdp-save-badge">SAVE @Model.SavePercent%</span>
                    }

                    @if (galleryImgs.Count > 1)
                    {
                        <button type="button" class="pdp-nav pdp-nav-prev" id="pdpPrev" aria-label="Previous image">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="15 18 9 12 15 6"/>
                            </svg>
                        </button>
                        <button type="button" class="pdp-nav pdp-nav-next" id="pdpNext" aria-label="Next image">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                                <polyline points="9 18 15 12 9 6"/>
                            </svg>
                        </button>

                        <div class="pdp-dots" id="pdpDots">
                            @for (int i = 0; i < galleryImgs.Count; i++)
                            {
                                <span class="pdp-dot @(i == 0 ? "active" : "")" data-index="@i"></span>
                            }
                        </div>
                    }
                </div>

                @if (galleryImgs.Count > 1)
                {
                    <div class="pdp-thumbs" id="pdpThumbs">
                        @for (int i = 0; i < galleryImgs.Count; i++)
                        {
                            var img = galleryImgs[i];
                            <button type="button"
                                    class="pdp-thumb @(i == 0 ? "active" : "")"
                                    data-img="@img"
                                    data-index="@i"
                                    aria-label="View image @(i + 1)">
                                <img src="@img" alt="@Model.Name @(i + 1)" />
                            </button>
                        }
                    </div>
                }
            }
            else
            {
                <div class="pdp-main-wrap">
                    <div class="pdp-no-image">No Image</div>
                </div>
            }
        </div>

        <!-- ================= RIGHT: Info ================= -->
        <div class="pdp-info">
            <p class="pdp-cat">
            @Model.Category?.Name
        </p>
        <h1>@Model.Name</h1>

         @{ bool hasSale = Model.SalePrice.HasValue && Model.SalePrice.Value > 0 && Model.SalePrice.Value < Model.MRP; }
            <div class="pdp-price-row">
                @if (hasSale)
                {
                    <span class="pdp-sale">₹@Model.SalePrice.Value.ToString("0")</span>
                    <span class="pdp-mrp">₹@Model.MRP.ToString("0")</span>
                    if (Model.SavePercent > 0)
                    {
                        <span class="pdp-save-pill">SAVE @Model.SavePercent%</span>
                    }
                }
                else
                {
                    <span class="pdp-sale">₹@Model.MRP.ToString("0")</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.ShortDescription))
            {
                <p class="pdp-short">@Model.ShortDescription</p>
            }

            @if (tags.Any())
            {
                <div class="pdp-tags">
                    @foreach (var t in tags)
                    {
                        <span class="pdp-tag">@t</span>
                    }
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Brand)
            || !string.IsNullOrWhiteSpace(Model.Composition)
            || !string.IsNullOrWhiteSpace(Model.GSM)
            || !string.IsNullOrWhiteSpace(Model.PrintType)
            || !string.IsNullOrWhiteSpace(Model.FitType)
            || !string.IsNullOrWhiteSpace(Model.Neckline))
            {
                <div class="pdp-tags pdp-tags-details">
                    @if (!string.IsNullOrWhiteSpace(Model.Brand))
                    {
                        <span class="pdp-tag"><strong>Brand:</strong> @Model.Brand</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Composition))
                    {
                        <span class="pdp-tag"><strong>Composition:</strong> @Model.Composition</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.GSM))
                    {
                        <span class="pdp-tag"><strong>GSM:</strong> @Model.GSM</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.PrintType))
                    {
                        <span class="pdp-tag"><strong>Print:</strong> @Model.PrintType</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.FitType))
                    {
                        <span class="pdp-tag"><strong>Fit:</strong> @Model.FitType</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Neckline))
                    {
                        <span class="pdp-tag"><strong>Neckline:</strong> @Model.Neckline</span>
                    }
                </div>
            }
        <div class="pdp-block">
            <div class="pdp-block-head">
                <label>SIZE</label>
                <button type="button" class="pdp-size-guide" id="openSizeChart">Size Guide</button>
            </div>

            @if (sizes.Any())
            {
                <div class="pdp-block">
                    <div class="pdp-sizes" id="pdpSizes">
                        @foreach (var s in sizes)
                        {
                            <button type="button" class="pdp-size-chip" data-size="@s">@s</button>
                        }
                    </div>
                </div>
            }

            @if (colors.Any())
            {
                <div class="pdp-block">
                    <label>COLOR</label>
                    <div class="pdp-colors" id="pdpColors">
                        @foreach (var c in colors)
                        {
                            var colorCss = c.Replace(" ", "").ToLower();
                            <button type="button"
                                    class="pdp-color-chip"
                                    data-color="@c"
                                    title="@c">
                                <span class="pdp-color-dot" style="background-color:@colorCss;"></span>
                                <span class="pdp-color-name">@c</span>
                            </button>
                        }
                    </div>
                </div>
            }

            <div class="pdp-block">
                <label>QUANTITY</label>
                <div class="pdp-qty" id="pdpQty">
                    <button type="button" class="qty-btn" data-step="-1" aria-label="Decrease">−</button>
                    <input type="text" class="qty-input" id="qtyInput" value="1" readonly />
                    <button type="button" class="qty-btn" data-step="1" aria-label="Increase">+</button>
                </div>
            </div>

           <div class="pdp-actions">
            <form method="post" action="/cart/add" id="addToCartForm" style="display: contents;">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <input type="hidden" name="size" id="selectedSize" value="" />
                <input type="hidden" name="color" id="selectedColor" value="" />
                <input type="hidden" name="quantity" id="selectedQty" value="1" />
                <input type="hidden" name="returnUrl" value="@Context.Request.Path" />

                <button type="submit" class="pdp-btn pdp-btn-primary" id="addToCartBtn">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
                        <line x1="3" y1="6" x2="21" y2="6"/>
                        <path d="M16 10a4 4 0 0 1-8 0"/>
                    </svg>
                    ADD TO CART
                </button>

                <button type="submit" class="pdp-btn pdp-btn-outline" id="buyNowBtn">
                    BUY NOW
                </button>
            </form>
        </div>

          <div class="pdp-meta">
            <p>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Free shipping above ₹999
            </p>
            <p>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Easy 7-day returns
            </p>
            <p>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                Cash on delivery available
            </p>

            @if (!string.IsNullOrWhiteSpace(Model.CountryOfProduction))
            {
                <p class="pdp-meta-country">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="10"/>
                        <line x1="2" y1="12" x2="22" y2="12"/>
                        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                    </svg>
                    Made in @Model.CountryOfProduction
                </p>
            }
        </div>

            @if (!string.IsNullOrWhiteSpace(Model.MRPNote) || !string.IsNullOrWhiteSpace(Model.AdditionalNote))
            {
                <div class="pdp-notes">
                    @if (!string.IsNullOrWhiteSpace(Model.MRPNote))
                    {
                        <p class="pdp-note">@Model.MRPNote</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.AdditionalNote))
                    {
                        <p class="pdp-note pdp-note-muted">@Model.AdditionalNote</p>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- ================= Validation Popup Modal ================= -->
<div class="pdp-toast-modal" id="pdpToastModal">
    <div class="pdp-toast-backdrop" id="pdpToastBackdrop"></div>
    <div class="pdp-toast-panel">
        <div class="pdp-toast-icon">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <line x1="12" y1="8" x2="12" y2="12"/>
                <line x1="12" y1="16" x2="12.01" y2="16"/>
            </svg>
        </div>
        <h3 class="pdp-toast-title" id="pdpToastTitle">Hold on!</h3>
        <p class="pdp-toast-message" id="pdpToastMessage">Please select a size first.</p>
        <button type="button" class="pdp-toast-btn" id="pdpToastClose">OK, GOT IT</button>
    </div>
</div>

<!-- ================= Size Chart Modal ================= -->
<div class="size-chart-modal" id="sizeChartModal">
    <div class="size-chart-backdrop" id="sizeChartBackdrop"></div>
    <div class="size-chart-panel">
        <div class="size-chart-header">
            <h3>SIZE GUIDE</h3>
            <button type="button" class="size-chart-close" id="closeSizeChart" aria-label="Close">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="18" y1="6" x2="6" y2="18"/>
                    <line x1="6" y1="6" x2="18" y2="18"/>
                </svg>
            </button>
        </div>

        <p class="size-chart-sub">All measurements are in inches. Garment measurements may vary by ±0.5".</p>

        <div class="size-chart-table-wrap">
            <table class="size-chart-table">
                <thead>
                    <tr>
                        <th>Size</th>
                        <th>Chest</th>
                        <th>Length</th>
                        <th>Shoulder</th>
                        <th>Sleeve</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td>S</td>  <td>40</td><td>27</td><td>18</td><td>8.5</td></tr>
                    <tr><td>M</td>  <td>42</td><td>28</td><td>19</td><td>9.0</td></tr>
                    <tr><td>L</td>  <td>44</td><td>29</td><td>20</td><td>9.5</td></tr>
                    <tr><td>XL</td> <td>46</td><td>30</td><td>21</td><td>10.0</td></tr>
                    <tr><td>XXL</td><td>48</td><td>31</td><td>22</td><td>10.5</td></tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Description) || !string.IsNullOrWhiteSpace(Model.WashCare)
     || !string.IsNullOrWhiteSpace(Model.SKU) || !string.IsNullOrWhiteSpace(Model.Composition))
{
    <section class="pdp-accordion">
        <div class="container">

            @if (!string.IsNullOrWhiteSpace(Model.SKU) || !string.IsNullOrWhiteSpace(Model.Composition)
                 || !string.IsNullOrWhiteSpace(Model.GSM) || !string.IsNullOrWhiteSpace(Model.PrintType)
                 || !string.IsNullOrWhiteSpace(Model.Neckline) || !string.IsNullOrWhiteSpace(Model.FitType)
                 || !string.IsNullOrWhiteSpace(Model.CountryOfProduction) || !string.IsNullOrWhiteSpace(Model.Brand)
                 || !string.IsNullOrWhiteSpace(Model.SizingNote))
            {
                <details>
                    <summary>PRODUCT DETAILS <span>+</span></summary>
                    <div class="pdp-details-grid">
                        @if (!string.IsNullOrWhiteSpace(Model.SKU))
                        {
                            <div class="pdp-detail-item"><span>SKU</span><strong>@Model.SKU</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Brand))
                        {
                            <div class="pdp-detail-item"><span>Brand</span><strong>@Model.Brand</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Composition))
                        {
                            <div class="pdp-detail-item"><span>Composition</span><strong>@Model.Composition</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.GSM))
                        {
                            <div class="pdp-detail-item"><span>GSM</span><strong>@Model.GSM</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.PrintType))
                        {
                            <div class="pdp-detail-item"><span>Print / Work</span><strong>@Model.PrintType</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.Neckline))
                        {
                            <div class="pdp-detail-item"><span>Neckline</span><strong>@Model.Neckline</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.FitType))
                        {
                            <div class="pdp-detail-item"><span>Fit</span><strong>@Model.FitType</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.CountryOfProduction))
                        {
                            <div class="pdp-detail-item"><span>Country of Production</span><strong>@Model.CountryOfProduction</strong></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SizingNote))
                        {
                            <div class="pdp-detail-item"><span>Sizing Note</span><strong>@Model.SizingNote</strong></div>
                        }
                    </div>
                </details>
            }

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <details>
                    <summary>DESCRIPTION <span>+</span></summary>
                    <p style="white-space: pre-line;">@Model.Description</p>
                </details>
            }

            @if (!string.IsNullOrWhiteSpace(Model.WashCare))
            {
                <details>
                    <summary>WASH CARE <span>+</span></summary>
                    <p style="white-space: pre-line;">@Model.WashCare</p>
                </details>
            }

            <details>
                <summary>SHIPPING & RETURNS <span>+</span></summary>
                <p>Free shipping on orders above ₹999. Easy 7-day returns on unused items with original tags. Cash on delivery available across India.</p>
            </details>
        </div>
    </section>
}
<script>
    // ---- Image gallery + mobile slider ----
    (function () {
        const mainImg = document.getElementById('pdpMainImg');
        const thumbs = document.querySelectorAll('.pdp-thumb');
        const prevBtn = document.getElementById('pdpPrev');
        const nextBtn = document.getElementById('pdpNext');
        const dots = document.querySelectorAll('.pdp-dot');
        if (!mainImg) return;

        const images = [];
        thumbs.forEach(t => images.push(t.dataset.img));
        if (images.length === 0) images.push(mainImg.src);

        let current = 0;

        function setActive(i) {
            current = i;
            mainImg.src = images[current];
            mainImg.style.opacity = '0';
            setTimeout(() => { mainImg.style.opacity = '1'; }, 80);
            thumbs.forEach((t, idx) => t.classList.toggle('active', idx === current));
            dots.forEach((d, idx) => d.classList.toggle('active', idx === current));
        }
        function next() { if (images.length > 1) setActive((current + 1) % images.length); }
        function prev() { if (images.length > 1) setActive((current - 1 + images.length) % images.length); }

        thumbs.forEach(t => t.addEventListener('click', () => setActive(parseInt(t.dataset.index, 10) || 0)));
        dots.forEach(d => d.addEventListener('click', () => setActive(parseInt(d.dataset.index, 10) || 0)));
        if (prevBtn) prevBtn.addEventListener('click', prev);
        if (nextBtn) nextBtn.addEventListener('click', next);

        let touchStartX = 0;
        mainImg.addEventListener('touchstart', e => { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        mainImg.addEventListener('touchend', e => {
            const dx = e.changedTouches[0].screenX - touchStartX;
            if (Math.abs(dx) < 40) return;
            if (dx < 0) next(); else prev();
        }, { passive: true });
    })();

    // ---- Size selector ----
    (function () {
        const chips = document.querySelectorAll('.pdp-size-chip');
        chips.forEach(c => {
            c.addEventListener('click', () => {
                chips.forEach(x => x.classList.remove('active'));
                c.classList.add('active');
            });
        });
    })();

    // ---- Color selector ----
    (function () {
        const chips = document.querySelectorAll('.pdp-color-chip');
        chips.forEach(c => {
            c.addEventListener('click', () => {
                chips.forEach(x => x.classList.remove('active'));
                c.classList.add('active');
            });
        });
    })();

    // ---- Quantity ----
    (function () {
        const qtyInput = document.getElementById('qtyInput');
        const btns = document.querySelectorAll('.qty-btn');
        if (!qtyInput) return;
        btns.forEach(b => {
            b.addEventListener('click', () => {
                let v = parseInt(qtyInput.value, 10) || 1;
                v += parseInt(b.dataset.step, 10);
                if (v < 1) v = 1;
                if (v > 10) v = 10;
                qtyInput.value = v;
            });
        });
    })();

    // ---- Size Chart Modal ----
    (function () {
        const modal = document.getElementById('sizeChartModal');
        const openBtn = document.getElementById('openSizeChart');
        const closeBtn = document.getElementById('closeSizeChart');
        const backdrop = document.getElementById('sizeChartBackdrop');
        if (!modal || !openBtn) return;

        function open() { modal.classList.add('open'); document.body.style.overflow = 'hidden'; }
        function close() { modal.classList.remove('open'); document.body.style.overflow = ''; }

        openBtn.addEventListener('click', open);
        if (closeBtn) closeBtn.addEventListener('click', close);
        if (backdrop) backdrop.addEventListener('click', close);
        document.addEventListener('keydown', e => {
            if (e.key === 'Escape' && modal.classList.contains('open')) close();
        });
    })();

       // ---- Cart button sync + validation ----
(function () {
    const sizeInput = document.getElementById('selectedSize');
    const colorInput = document.getElementById('selectedColor');
    const qtyInput = document.getElementById('selectedQty');
    const addForm = document.getElementById('addToCartForm');

    // Toast modal elements
    const toastModal = document.getElementById('pdpToastModal');
    const toastBackdrop = document.getElementById('pdpToastBackdrop');
    const toastClose = document.getElementById('pdpToastClose');
    const toastTitle = document.getElementById('pdpToastTitle');
    const toastMessage = document.getElementById('pdpToastMessage');

    let pendingSubmit = null;

    // ---- Show toast ----
    function showToast(title, message, onSubmit) {
        if (!toastModal) return;
        toastTitle.textContent = title || 'Hold on!';
        toastMessage.textContent = message || '';
        pendingSubmit = onSubmit || null;
        toastModal.classList.add('open');
        document.body.style.overflow = 'hidden';
    }

    function closeToast() {
        if (!toastModal) return;
        toastModal.classList.remove('open');
        document.body.style.overflow = '';
        pendingSubmit = null;
    }

    if (toastClose) toastClose.addEventListener('click', closeToast);
    if (toastBackdrop) toastBackdrop.addEventListener('click', closeToast);
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && toastModal && toastModal.classList.contains('open')) {
            closeToast();
        }
    });

    // ---- Size chips ----
    document.querySelectorAll('.pdp-size-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            if (sizeInput) sizeInput.value = chip.dataset.size || '';
        });
    });

    // ---- Color chips ----
    document.querySelectorAll('.pdp-color-chip').forEach(chip => {
        chip.addEventListener('click', () => {
            if (colorInput) colorInput.value = chip.dataset.color || '';
        });
    });

    // ---- Quantity sync ----
    const qtyVisible = document.getElementById('qtyInput');
    if (qtyVisible && qtyInput) {
        const syncQty = () => { qtyInput.value = qtyVisible.value; };
        document.querySelectorAll('.qty-btn').forEach(b => b.addEventListener('click', syncQty));
    }

    // ---- Validation on submit ----
    const sizesExist = document.querySelectorAll('.pdp-size-chip').length > 0;
    const colorsExist = document.querySelectorAll('.pdp-color-chip').length > 0;

    if (addForm) {
        addForm.addEventListener('submit', (e) => {
            // Size check
            if (sizesExist && (!sizeInput || !sizeInput.value)) {
                e.preventDefault();
                showToast('Size Required', 'Please select a size before adding to cart.');
                // Scroll to sizes + highlight
                const sizeBlock = document.querySelector('.pdp-sizes');
                if (sizeBlock) {
                    sizeBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    sizeBlock.classList.add('pdp-required-flash');
                    setTimeout(() => sizeBlock.classList.remove('pdp-required-flash'), 1200);
                }
                return;
            }

            // Color check
            if (colorsExist && (!colorInput || !colorInput.value)) {
                e.preventDefault();
                showToast('Color Required', 'Please select a color before adding to cart.');
                const colorBlock = document.querySelector('.pdp-colors');
                if (colorBlock) {
                    colorBlock.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    colorBlock.classList.add('pdp-required-flash');
                    setTimeout(() => colorBlock.classList.remove('pdp-required-flash'), 1200);
                }
                return;
            }
        });
    }

    // ---- Buy Now: mark intent (future) ----
    const buyNow = document.getElementById('buyNowBtn');
